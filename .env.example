# Copy to .env to RUN the app locally (uvicorn, celery, sandloom migrate). The test
# suite does not need it: it reads .env.test, with SANDLOOM_TEST_DATABASE_URL /
# SANDLOOM_TEST_CACHE_URL / SANDLOOM_TEST_BROKER_URL overriding it (docs/guides/testing.md).
#
# Every setting lives in src/sandloom/core/config/settings.py. Commented-out entries show
# the default; uncomment to override. JSON-typed settings (lists/objects) take
# a JSON value.

# ==== Environment ====
# dev | test | prod. prod turns on the production validation (secret strength,
# strict event schemas, billing/2FA requirements, fail-closed defaults).
# ENVIRONMENT=dev
# The ONE list of weaker guarantees this deployment accepts in prod (ADR-0006):
# JSON list or comma-separated ids, e.g. local_storage_in_prod,fake_psp_in_prod.
# Ids: fake_psp_in_prod, log_notifier_in_prod, local_storage_in_prod,
# volatile_event_bus, unversioned_ddl_repair, weak_password_hash,
# shared_hs_secret_split, relay_disabled. An unknown id fails startup; each
# accepted risk is logged at every start and exported as
# sandloom_accepted_risk_active{risk}. Replaces the deprecated *_ALLOW_* flags.
# SANDLOOM_ACCEPTED_RISKS=[]

# ==== Modules ====
# Which business modules this process loads (JSON list): an installed module
# package's `sandloom.modules` entry-point name (identity) or any import path
# (sandloom_identity, app.modules.notes). The kernel names no modules by
# default; the standard root (sandloom.main) loads every installed module
# package when this is unset.
SANDLOOM_MODULES=["identity","tenancy","billing"]
# Modules whose load failure aborts startup (only enforced when also requested).
MODULE_REQUIRED=["identity"]
# Composition root (module exposing `app` / `core`) booted by the Celery worker,
# sandloom migrate and the `sandloom` ops CLIs. Unset = the standard `sandloom.main`; a
# generated app uses `<app>.asgi`. The process env var wins over this file.
# SANDLOOM_COMPOSITION_ROOT=sandloom.main
# Optional filters / discovery knobs for the plugin loader.
# MODULE_WHITELIST=[]
# MODULE_BLACKLIST=[]
# MODULE_FAIL_FAST=false
# Load every installed `sandloom.modules` entry point on top of the list.
# MODULE_LOAD_ENTRYPOINTS=false

# ==== Lifecycle / health ====
# STARTUP_TASK_TIMEOUT_SECONDS=15
# SHUTDOWN_TASK_TIMEOUT_SECONDS=10
# HEALTH_CHECK_TIMEOUT_SECONDS=5.0
# Public /health and /ready reuse probe results this long (seconds); 0 = off.
# HEALTH_CACHE_TTL_SECONDS=3.0
# Required event consumers: startup wait + reconnect backoff (seconds).
# CONSUMER_STARTUP_TIMEOUT_SECONDS=15.0
# CONSUMER_RETRY_BASE_SECONDS=1.0
# CONSUMER_RETRY_MAX_SECONDS=30.0
# Streams eventing (EVENT_BUS_BACKEND=streams): service label stamped into
# consumer ids / diagnostics, per-channel retention, optional key namespace for
# several environments sharing one Redis.
# SANDLOOM_SERVICE_NAME=billing-api
# EVENT_STREAM_RETENTION_SECONDS=604800
# EVENT_STREAM_MAXLEN=0
# EVENT_STREAM_PREFIX=

# ==== Database ====
# This is the "default" database instance.
DATABASE_URL=postgresql+asyncpg://test_user:test_password@localhost:5433/sandloom_dev
# System channel of the default database — only with tenant RLS
# (INFRA={"database":{"default":{"tenant_rls":true}}}). A SEPARATE least-privilege
# login role (NOSUPERUSER NOBYPASSRLS) used only by framework-internal, audited
# cross-tenant work; never the app role. See docs/concepts/multi-tenancy.md.
# DATABASE_SYSTEM_URL=postgresql+asyncpg://sandloom_system:change-me@db:5432/career_assistant
# Connection pool sizing (production tuning).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
# asyncpg connection establishment (not SQL execution): finite connect timeout,
# exponential recovery probes with equal jitter and one probe per process/pool.
DB_CONNECT_TIMEOUT_SECONDS=5
DB_RECONNECT_BASE_SECONDS=0.05
DB_RECONNECT_MAX_SECONDS=2
# Checkout ping only for a connection idle >= this many seconds (1 round trip;
# 0 = every checkout, negative = never). Replaces pool_pre_ping (3 per checkout).
# DB_POOL_PING_IDLE_SECONDS=5
# A pooled connection found dead before a byte of a fresh transaction was sent
# (its backend died while idle) is replaced and the message re-sent once.
# Anything that reached a dying connection is a 503. Default ON; kill switch.
# DB_DEAD_CONNECTION_RETRY=true
# PROTOTYPE: routes declaring ReadOnlyDbSession read in autocommit, refuse writes.
# DB_READ_ONLY_SESSIONS=false
# tenant_rls + asyncpg: BEGIN + tenant set_config in ONE message (one round
# trip fewer per RLS transaction). Default ON; set false as a kill switch.
# DB_RLS_MERGED_BEGIN=true
# Declared planner reads use the safe optimized executor where eligible.
# Types / ORM policies that require SQLAlchemy automatically use the ORM.
# Set false and restart to roll back the executor without changing module code.
# PLANNER_OPTIMIZED_EXECUTOR=true
# Overflow hysteresis: keep returned overflow connections idle while the pool
# was short of idle connections within this many seconds, instead of closing
# them at once and reconnecting on the next shortage (0 = stock QueuePool).
# DB_POOL_OVERFLOW_LINGER_SECONDS=30
# Fair checkout: while the oldest waiting checkout has waited less than this,
# a returned connection goes to whoever runs first (no reserved idle
# connection); past it the connection is handed to that waiter (0 = strict
# FIFO handoff).
# DB_POOL_FAIR_BARGE_MS=25
# Server-side guards in the startup packet (0 = off; set 0 behind a PgBouncer
# that rejects unknown startup parameters).
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_IDLE_IN_TX_TIMEOUT_MS=60000
# Dedicated pool for in-process contract calls (per process, same database).
# CONTRACT_DB_POOL_SIZE=5
# CONTRACT_DB_MAX_OVERFLOW=5

# ==== Infrastructure plugins (optional) ====
# Declare ADDITIONAL named infrastructure instances or override the synthesized
# defaults — purely by configuration, no code change. Capabilities: database,
# cache, objectstore, taskqueue, eventbus. Each instance picks a "driver" plus
# driver-specific options. Example: a second database for analytics + a
# dedicated cache for sessions.
# INFRA={"database":{"analytics":{"driver":"sqlalchemy","url":"postgresql+asyncpg://career:assistant@db:5432/analytics"}},"cache":{"sessions":{"driver":"redis","url":"redis://redis:6379/3"}}}
# Remote providers for sync service contracts absent from this process.
# SERVICE_BINDINGS={"tenancy.membership.v1":{"base_url":"http://tenancy:2222"}}
# SERVICE_RPC_TIMEOUT_SECONDS=1.0
# Outbound RPC client: aiohttp (default) | httpx (behind an egress proxy).
# aiohttp: per-peer pool bound, idle eviction, response cap.
# RPC_TRANSPORT=aiohttp
# RPC_POOL_MAX_CONNECTIONS=100
# RPC_POOL_IDLE_SECONDS=4.0
# RPC_MAX_RESPONSE_BYTES=33554432
# Authorization access-fact resolution modes (claim/projection/live/auto).
# ACCESS={"subscription.active":"live"}

# ==== Cache (Redis) ====
CACHE_URL=redis://localhost:6380/1
# Bounded cache client: a dead / hung Redis makes operations RAISE within
# ~(1 + retries) x socket timeout, so fail-open / fail-closed policies run.
# CACHE_SOCKET_TIMEOUT_SECONDS=0.5
# CACHE_SOCKET_CONNECT_TIMEOUT_SECONDS=0.5
# CACHE_HEALTH_CHECK_INTERVAL_SECONDS=30
# Blocking pool cap per process; a caller waits CACHE_POOL_TIMEOUT_SECONDS
# for a free connection, then errors.
# CACHE_MAX_CONNECTIONS=64
# CACHE_POOL_TIMEOUT_SECONDS=1.0
# Retries of connection errors only (never timeouts).
# CACHE_RETRY_ATTEMPTS=1

# ==== Broker (Celery / tasks) ====
BROKER_URL=redis://localhost:6380/2

# ==== Events / outbox ====
# (All of these are Settings fields: .env, the process env and SECRETS_DIR files
# all work, and values are validated at startup.)
# auto = redis in prod, in-memory otherwise (memory | redis | streams).
# EVENT_BUS_BACKEND=auto
# Transactional outbox relay: auto = prod processes only (on | off). off in a
# prod app process needs SANDLOOM_ACCEPTED_RISKS=relay_disabled; gunicorn sets
# "delegated" on every worker but the relay leader.
# OUTBOX_RELAY_ENABLED=auto
# Poison rows are dead-lettered after this many failed publishes.
# OUTBOX_RELAY_MAX_ATTEMPTS=10
# Per-row retry backoff: base * 2**(n-1), capped, with jitter (seconds).
# OUTBOX_RELAY_BACKOFF_BASE_SECONDS=2.0
# OUTBOX_RELAY_BACKOFF_MAX_SECONDS=300.0
# Broker-outage circuit breaker cool-down (exponential, capped; seconds).
# OUTBOX_RELAY_CIRCUIT_BASE_SECONDS=1.0
# OUTBOX_RELAY_CIRCUIT_MAX_SECONDS=30.0
# Delivered outbox rows are purged by the relay after this many hours (0 = keep).
# OUTBOX_RETENTION_HOURS=168
# Durable consumers on a Pub/Sub bus outside prod: SANDLOOM_ACCEPTED_RISKS has
# volatile_event_bus. The forced `sandloom migrate ensure-outbox --force --apply`
# in prod: unversioned_ddl_repair (a deliberate one-off only).
# Event contract validation: off-schema events are always refused; prod also
# requires a schema for every versioned channel and caps payloads at 256 KiB.
# SCHEMA_REQUIRE_ALL_VERSIONED=false
# EVENT_PAYLOAD_MAX_BYTES=0
# EVENT_CALLBACK_TIME_BUDGET_SECONDS=0.0
# EVENT_SHUTDOWN_DRAIN_SECONDS=5.0
# EVENT_BUS_REDIS_SEMAPHORE_LIMIT=100
# SCHEMA_REGISTRY_PATH=./data/schema_registry.json

# ==== Storage ====
STORAGE_TYPE=local
STORAGE_PATH=./data
# Upload cap enforced by the storage layer (0 = unlimited).
# MAX_UPLOAD_SIZE_BYTES=52428800
# S3 (required when STORAGE_TYPE=s3)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ==== API limits / docs ====
# Global request-body cap (Content-Length -> 413). 0 = use MAX_UPLOAD_SIZE_BYTES.
MAX_REQUEST_BODY_BYTES=0
# Expose /docs,/redoc,/openapi.json. Unset = on outside prod, off in prod.
# DOCS_ENABLED=false
# CORS allowed origins (JSON list). Empty = [FRONTEND_URL].
# CORS_ORIGINS=["http://localhost:3000"]
# Rate limiting is always on in prod; set true to force it elsewhere.
# RATE_LIMIT_ENABLED=false
# Per-route limits apply only where a route declares rate_limiter; unknown
# paths (404 scans) are otherwise unlimited in the app. Opt-in per-IP floor
# across every route (0 = off; one cache round trip per request, fail-open):
# RATE_LIMIT_GLOBAL_REQUESTS=0
# RATE_LIMIT_GLOBAL_PERIOD_SECONDS=60
# RATE_LIMIT_GLOBAL_EXEMPT_PATH_PREFIXES=["/health","/ready","/metrics","/_sandloom/"]

# ==== Client IP / proxies ====
# Honour X-Forwarded-For from the fronting gateway ...
# TRUST_PROXY_HEADERS=false
# ... but only when the TCP peer is one of these proxy CIDRs (JSON list). With
# TRUST_PROXY_HEADERS on and this empty, prod ignores XFF (uses the peer).
# TRUSTED_PROXY_IPS=["10.0.0.0/8"]

# ==== JWT / Security ====
JWT_SECRET=super_secret_key_change_me
JWT_ALGORITHM=HS256
# Must be IDENTICAL in every service of a split deployment (the minting and
# the revoking service may differ).
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
# Lifetime of a token-revocation mark (seconds). Default: max(access TTL +
# 120s, 24h), so a mark written by one service outlives tokens minted by
# another even if their ACCESS_TOKEN_EXPIRE_MINUTES differ. Never below the
# writer's own access TTL + 120s.
# AUTH_REVOCATION_MARK_TTL_SECONDS=86400
# Optional issuer/audience binding (minted AND verified when set).
# JWT_ISSUER=
# JWT_AUDIENCE=
# Clock-skew tolerance for exp/nbf/iat (seconds).
# JWT_LEEWAY_SECONDS=10
# Key rotation: retired secrets still accepted for VERIFICATION only (JSON
# list; same strength rules as JWT_SECRET in prod). Rotate by moving the old
# JWT_SECRET here, keep it >= ACCESS_TOKEN_EXPIRE_MINUTES, then remove it.
# JWT_PREVIOUS_SECRETS=[]
# Optional key id stamped as the JWT "kid" header; a token carrying the
# current kid is verified with JWT_SECRET only. Change it on every rotation.
# JWT_KID=2026-10
# Token revocation ("tokens valid after", per user, in the cache): when the
# cache is unreachable, reject tokens with 503 (true) or accept them (false).
# Unset = true in prod, false elsewhere.
# AUTH_REVOCATION_FAIL_CLOSED=
# Revocation is strict by default (every request reads the mark). A GET/HEAD
# route may declare revocation_freshness(max_staleness_s<=5); routes under
# these prefixes stay strict regardless (JSON list).
# AUTH_REVOCATION_STRICT_PATH_PREFIXES=["/api/v1/admin"]
# Max concurrent argon2 hash/verify per process (~64 MiB each). Unset =
# min(4, available CPUs).
# PASSWORD_HASH_CONCURRENCY=
# argon2id work factor. PROFILE: strong (default; m=65536 KiB, t=3, p=4,
# ~120 ms CPU per login on an M1 Max) | owasp_min (OWASP Password Storage
# Cheat Sheet minimum: m=19456 KiB, t=2, p=1, ~21 ms) | custom (set all
# three values). Explicit values override the preset. Stored hashes keep
# verifying and are re-hashed on the next successful login.
# PASSWORD_HASH_PROFILE=strong
# PASSWORD_HASH_TIME_COST=
# PASSWORD_HASH_MEMORY_KIB=
# PASSWORD_HASH_PARALLELISM=
# Below the OWASP minimum prod refuses to start unless SANDLOOM_ACCEPTED_RISKS has
# weak_password_hash (logged loudly on every start). Outside prod weak values
# only warn.
# Dedicated key(s) encrypting TOTP secrets at rest (comma-separated, newest
# first for rotation). REQUIRED in prod when identity is loaded (no JWT_SECRET
# fallback); generate with: openssl rand -hex 32
# TWOFA_ENCRYPTION_KEY=

# ==== Internal / ops endpoints ====
# Unlocks /metrics, /diagnostics/*, /contracts/*, internal RPC and /health
# details (sent as X-Internal-Token). Unset = those endpoints are disabled.
# INTERNAL_API_TOKEN=
# Dev-only: open the internal endpoints when no INTERNAL_API_TOKEN is set.
# INTERNAL_ENDPOINTS_OPEN_IN_DEV=false
# Scrape-only credential for /metrics (must differ from INTERNAL_API_TOKEN).
# METRICS_TOKEN=

# ==== Tenant isolation ====
# multi: tenant comes from signed access-token claims; X-Tenant-Id may only
# select an id present in tenant_ids. single: always bind SINGLE_TENANT_ID.
TENANCY_MODE=multi
# SINGLE_TENANT_ID=00000000-0000-0000-0000-000000000001

# ==== Billing ====
# fake (default, dev/test) | stripe. Prod rejects the fake PSP unless
# SANDLOOM_ACCEPTED_RISKS has fake_psp_in_prod (demo stacks only).
# BILLING_PROVIDER=fake
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# BILLING_DENY_ON_PAST_DUE=false
# A subscription created WITHOUT a Sandloom operation intent (operator-created in
# Stripe, migrated, restored) is synced but grants entitlements only when this
# is true (and its price is in the catalog). Default false = fail closed;
# subscriptions that existed before this setting keep granting. ADR-0003 item 9.
# BILLING_GRANT_INTENTLESS_SUBSCRIPTIONS=false
# Periodic intent reconciler (worker beat, #72): a checkout/portal intent left
# pending this long (its client never retried) is looked up at the PSP and
# closed; failing PSP steps are retried up to MAX_ATTEMPTS, then left to an
# operator (followup_at).
# BILLING_INTENT_RECONCILE_AFTER_MINUTES=30
# BILLING_INTENT_RECONCILE_MAX_ATTEMPTS=5
# A plan / cancel-at-period-end change with no portal intent issued for the
# customer within this window is audited billing.subscription.
# unattributed_change (never blocked). ADR-0003 item 10.
# BILLING_PORTAL_ATTRIBUTION_WINDOW_MINUTES=60

# ==== Notifications ====
# log (default: structured log line, recipient hashed) | smtp.
# NOTIFIER_BACKEND=log
# In prod the log driver advertises no channels, so a module requiring e.g.
# features={"email"} fails at startup instead of logging undelivered mail;
# SANDLOOM_ACCEPTED_RISKS=log_notifier_in_prod restores them (demo stacks only).
# SMTP_HOST=
# SMTP_PORT=25
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_USE_TLS=true

# ==== Frontend ====
FRONTEND_URL=http://localhost:3000

# ==== SSO Providers ====
# Unset = the provider is off. Placeholder values would make it look
# configured (and fail identity's "missing credentials" tests).
# Google OAuth2
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Microsoft OAuth2 (optional)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# GitHub / LinkedIn / Telegram (optional)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# Telegram login is not implemented yet: the provider is never listed and its
# redirect is rejected even when this is set.
# TELEGRAM_BOT_TOKEN=
# Allowed SSO redirect URIs (comma-separated).
# SSO_ALLOWED_REDIRECT_URIS=http://localhost:3000,http://localhost:3000/auth/callback

# ==== Monitoring / Logging ====
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# OTLP endpoint; tracing is off while empty (needs opentelemetry-sdk installed).
TRACING_URL=
# OTEL_SERVICE_NAME=sandloom-backend
# Logging: format=auto -> JSON in prod, human text otherwise. Override with json/text.
LOG_FORMAT=auto
LOG_LEVEL=INFO

# ==== Secrets (optional) ====
# Directory of Docker/K8s secret files named after settings fields
# (e.g. /run/secrets/jwt_secret). Overrides env for those fields.
# SECRETS_DIR=/run/secrets
