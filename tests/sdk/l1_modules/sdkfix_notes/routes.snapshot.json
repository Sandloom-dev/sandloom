{
  "format": 3,
  "module": "sdkfix_notes",
  "routes": [
    {
      "auth": "authenticated",
      "method": "POST",
      "path": "/api/v1/sdkfix_notes/",
      "policy": {
        "effect": "write",
        "idempotency": "automatic S",
        "session": "live, re-check before commit",
        "write_store": "default"
      }
    },
    {
      "auth": "public",
      "method": "GET",
      "path": "/api/v1/sdkfix_notes/health",
      "policy": {
        "effect": "read",
        "idempotency": "none",
        "public_reason": "liveness probe",
        "session": "none"
      }
    },
    {
      "auth": "authenticated",
      "method": "GET",
      "path": "/api/v1/sdkfix_notes/settings",
      "policy": {
        "effect": "read",
        "idempotency": "none",
        "session": "live, re-check if a unit writes"
      }
    }
  ]
}
