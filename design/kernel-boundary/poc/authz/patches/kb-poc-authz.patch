+
+@functools.lru_cache(maxsize=512)
+def _file_literals(path: Path) -> dict[str, dict[str, Any]]:
+    try:
+        return _class_literals(ast.parse(path.read_text(encoding="utf-8")))
+    except (OSError, SyntaxError, UnicodeDecodeError):
+        return {}
+
+
+def atom_literals(tree: ast.AST) -> dict[str, dict[str, Any]]:
+    """``{local name: literal}`` of the atoms a module defines or imports."""
+    found = dict(_class_literals(tree))
+    for node in getattr(tree, "body", ()):
+        if not isinstance(node, ast.ImportFrom) or not node.module or node.level:
+            continue
+        path = _module_file(node.module)
+        if path is None:
+            continue
+        literals = _file_literals(path)
+        for alias in node.names:
+            if alias.name in literals:
+                found[alias.asname or alias.name] = literals[alias.name]
+    return found
+
+
+def _kinds(literal: dict[str, Any]) -> set[str]:
+    binds = literal.get("binds") or {}
+    return {b[0] for b in binds.values() if isinstance(b, list) and b}
+
+
+def binds_org(literal: dict[str, Any]) -> str | None:
+    """The default organization parameter of an atom with an org bind."""
+    for bind in (literal.get("binds") or {}).values():
+        if isinstance(bind, list) and bind and bind[0] == "org":
+            return str(bind[1] or "org_id")
+    return None
