--- /dev/null
+++ b/src/sandloom/shared/authz/witness.py
@@ -0,0 +1,62 @@
+"""Declared membership witnesses (PoC kb-poc-authz, K1).
+
+A generated access check that declares ``witnesses_membership`` registers its
+contract method here when its class is defined; :func:`tenant_kind` asks it
+whether the caller is a member of a bound tenant, instead of a kernel-chosen
+membership contract. The real change would take the witness from the
+application-assigned tenant authority (decision C part (a)), not from import
+order.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any
+from uuid import UUID
+
+from sandloom.shared.authz._resolve import ContractUnavailable, resolve_contract
+
+if TYPE_CHECKING:  # pragma: no cover - typing only
+    from sandloom.shared.authz.context import AuthzContext
+
+#: contract name -> (method, argument plan, argument order)
+WITNESSES: dict[str, tuple[str, dict[str, Any], list[str]]] = {}
+
+
+def register_witness(
+    contract: str, method: str, plan: dict[str, Any], order: list[str]
+) -> None:
+    WITNESSES[contract] = (method, plan, order)
+
+
+def membership_witness() -> tuple[str, str, dict[str, Any], list[str]] | None:
+    """The one declared membership check (contract, method, plan, order), or
+    ``None``. Two different declared checks are ambiguous: none is used."""
+    if len(WITNESSES) != 1:
+        return None
+    contract, (method, plan, order) = next(iter(WITNESSES.items()))
+    return contract, method, plan, order
+
+
+async def witness_is_member(ctx: AuthzContext, org_id: UUID) -> bool | None:
+    """Ask the declared membership witness; ``None`` when none is declared."""
+    found = membership_witness()
+    if found is None:
+        return None
+    contract, method, plan, order = found
+    try:
+        service = resolve_contract(ctx, contract)
+    except ContractUnavailable:
+        return False  # no membership authority: the kind stays unknown
+    args: list[Any] = []
+    for arg in order:
+        source = plan[arg]
+        if source == "org":
+            args.append(org_id)
+        elif source == "subject":
+            args.append(ctx.subject.user_id)
+        else:
+            args.append(source)
+    return bool(await getattr(service, method)(*args))
+
+
+__all__ = ["WITNESSES", "membership_witness", "register_witness", "witness_is_member"]
