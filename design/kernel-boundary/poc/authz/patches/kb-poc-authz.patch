+# --------------------------------------------------------------------------- #
+# hand-written Requirement calling a declared access check (answer #22)
+# --------------------------------------------------------------------------- #
+def _ref_literals(tree: ast.AST) -> dict[str, dict[str, dict[str, Any]]]:
+    """``{REF constant: {method: literal}}`` of the imported stubs that
+    declare access checks."""
+    ref_literals: dict[str, dict[str, dict[str, Any]]] = {}
+    for node in getattr(tree, "body", ()):
+        if not isinstance(node, ast.ImportFrom) or not node.module or node.level:
+            continue
+        path = _module_file(node.module)
+        if path is None:
+            continue
+        by_method = {
+            str(lit.get("method")): lit
+            for lit in _file_literals(path).values()
+            if "method" in lit
+        }
+        if not by_method:
+            continue
+        for alias in node.names:
+            if alias.name.isupper():  # the ContractRef constant
+                ref_literals[alias.asname or alias.name] = by_method
+    return ref_literals
+
+
+def _declared_methods(tree: ast.AST) -> dict[str, dict[str, dict[str, Any]]]:
+    """``{client name: {method: literal}}`` for ``x = Contract(REF)`` whose
+    stub declares access checks."""
+    ref_literals = _ref_literals(tree)
+    clients: dict[str, dict[str, dict[str, Any]]] = {}
+    for node in getattr(tree, "body", ()):
+        if (
+            isinstance(node, ast.Assign)
+            and isinstance(node.value, ast.Call)
+            and _name(node.value) == "Contract"
+            and node.value.args
+            and isinstance(node.value.args[0], ast.Name)
+            and node.value.args[0].id in ref_literals
+        ):
+            for target in node.targets:
+                if isinstance(target, ast.Name):
+                    clients[target.id] = ref_literals[node.value.args[0].id]
+    return clients
