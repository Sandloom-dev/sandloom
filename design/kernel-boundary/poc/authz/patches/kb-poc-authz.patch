+def _call_params(call: ast.Call, literal: dict[str, Any]) -> dict[str, Any]:
+    names = [
+        a for a in literal.get("args") or [] if a not in (literal.get("binds") or {})
+    ]
+    params: dict[str, Any] = {}
+    for name, arg in zip(names, call.args, strict=False):
+        if isinstance(arg, ast.Constant):
+            params[name] = arg.value
