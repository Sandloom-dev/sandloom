+
+_TIERS = {"TIER_CLAIM": 1, "TIER_RESOURCE": 2, "TIER_LIVE": 3}
+
+
+def _class_attr(cls: ast.ClassDef, name: str) -> Any:
+    for item in cls.body:
+        if (
+            isinstance(item, ast.Assign)
+            and len(item.targets) == 1
+            and isinstance(item.targets[0], ast.Name)
+            and item.targets[0].id == name
+        ):
+            value = item.value
+            if isinstance(value, ast.Constant):
+                return value.value
+            if isinstance(value, ast.Name):
+                return _TIERS.get(value.id, value.id)
+            if isinstance(value, ast.Attribute):
+                return value.attr.lower()
+    return None
+
+
+def handwritten_access_checks(tree: ast.AST) -> list[str]:
+    """``Line N: ...`` for each hand-written ``Requirement`` whose body calls
+    a declared access check with metadata that differs from the declaration
+    (tier, category, a declared risk the class does not state)."""
+    clients = _declared_methods(tree)
+    if not clients:
+        return []
+    out: list[str] = []
+    for cls in ast.walk(tree):
+        if not isinstance(cls, ast.ClassDef) or ATOM_ATTR in {
+            t.id
+            for item in cls.body
+            if isinstance(item, ast.AnnAssign | ast.Assign)
+            for t in (
+                [item.target] if isinstance(item, ast.AnnAssign) else item.targets
+            )
+            if isinstance(t, ast.Name)
+        }:
+            continue
+        for node in ast.walk(cls):
+            if not (
+                isinstance(node, ast.Call)
+                and isinstance(node.func, ast.Attribute)
+                and isinstance(node.func.value, ast.Name)
+                and node.func.attr in clients.get(node.func.value.id, {})
+            ):
+                continue
+            literal = clients[node.func.value.id][node.func.attr]
+            where = (
+                f"Line {cls.lineno}: {cls.name} calls the declared access check "
+                f"{literal['contract']}.{literal['method']}"
+            )
+            tier = _class_attr(cls, "tier")
+            if tier != literal.get("tier"):
+                out.append(f"{where} with tier {tier!r} (declared {literal['tier']})")
+            category = _class_attr(cls, "category")
+            if category != literal.get("category"):
+                out.append(
+                    f"{where} with category {category!r} (declared "
+                    f"{literal.get('category')!r})"
+                )
+            states_risk = any(
+                isinstance(item, ast.FunctionDef) and item.name == "risks"
+                for item in cls.body
+            )
+            if literal.get("risk") and not states_risk:
+                out.append(
+                    f"{where} but does not state its declared risk "
+                    f"{sorted(literal['risk'])} (risks())"
+                )
+            break
+    return out
+
+
+__all__ = [
+    "admin_gate",
+    "atom_literals",
+    "binds_account",
+    "binds_org",
+    "call_risks",
+    "handwritten_access_checks",
+]
