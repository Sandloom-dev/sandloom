index 0000000..3d99917
--- /dev/null
+++ b/src/sandloom/core/archcheck/atom_metadata.py
@@ -0,0 +1,279 @@
+"""Static metadata of generated access atoms (PoC kb-poc-authz, H-20).
+
+The archcheck rules that used to recognise an atom by its class name
+(``OrgRole``, ``Credits``, ...) read the ``__sandloom_atom__`` literal that
+``sandloom generate`` writes into the atom's class instead: an imported name
+is resolved to its source file on ``sys.path`` (no import), the class's literal
+is read with ``ast.literal_eval``. A third-party atom with an organization
+bind or an admin risk is recognised by what it declares, not by its name.
+
+It also recognises a hand-written ``Requirement`` whose body calls a declared
+access check through ``Contract(REF)`` (owner answer #22): its tier, category
+and risk are compared with the declaration.
+"""
+
+from __future__ import annotations
+
+import ast
+import functools
+import sys
+from pathlib import Path
+from typing import Any
+
+ATOM_ATTR = "__sandloom_atom__"
+
+
+@functools.lru_cache(maxsize=512)
+def _module_file(module: str) -> Path | None:
+    rel = Path(*module.split("."))
+    for entry in sys.path:
+        if not entry:
+            continue
+        base = Path(entry)
+        for candidate in (base / f"{rel}.py", base / rel / "__init__.py"):
+            if candidate.is_file():
+                return candidate
+    return None
