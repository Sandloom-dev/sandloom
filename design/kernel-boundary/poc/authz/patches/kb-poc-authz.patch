diff --git a/src/sandloom/shared/authz/contract_check.py b/src/sandloom/shared/authz/contract_check.py
new file mode 100644
index 0000000..87b1402
--- /dev/null
+++ b/src/sandloom/shared/authz/contract_check.py
@@ -0,0 +1,450 @@
+"""Contract-anchored access checks (PoC kb-poc-authz, alternative PA-2).
+
+A provider marks ONE boolean read method of its contract with
+:func:`access_check`; ``sandloom generate`` writes a typed atom class next to
+the contract's stub, carrying the declaration as a literal
+(``__sandloom_atom__``); every such atom is evaluated by the one generic,
+domain-free :class:`ContractCheck` below. The kernel names no module,
+contract, method or role word: the literal does.
+
+Binding sources (:class:`From`) are the kernel's own concepts:
+
+* ``From.subject_id()`` — the authenticated principal's user id;
+* ``From.org(param=..., validate_against_token=...)`` — the organization from
+  the path/query parameter (the atom's ``org_param=``), else ``X-Tenant-Id``,
+  else the bound tenant (:func:`resolve_org_id`);
+* ``From.account_type()`` / ``From.account_id()`` — the billing account the
+  atom's required ``of=`` names (:func:`resolve_account`).
+
+Every other parameter of the method is a parameter of the atom (its
+constructor), passed through unchanged.
+
+Claim-tier atoms (:class:`ClaimFactCheck`) are generated from an owner's
+:class:`~sandloom.shared.authz.facts.AccessFact` that names an ``atom``: they
+read the owner's claim under its provenance, zero I/O, exactly like today's
+``Subscribed(of=Account.user())``.
+
+Separate changes behind PoC switches (each measured as its own run; the
+switch names are PoC-only, a real change would be unconditional):
+
+* ``KB_POC_K5`` — a bound provider that is down (transport failure, timeout,
+  provider 5xx) is an indeterminate 503 inside the algebra; an RPC
+  authentication failure stays an error.
+* ``KB_POC_WITNESS`` — an allowing check that declares
+  ``witnesses_membership`` records the membership in the request's
+  tenant-kind memo, so ``Account.bound_tenant()`` after ``OrgRole`` needs no
+  second membership call (owner answer #23).
+"""
+
+from __future__ import annotations
+
+import logging
+from typing import TYPE_CHECKING, Any, ClassVar
+from uuid import UUID
+
+import sandloom.shared.authz.facts as _facts
+import sandloom.shared.authz.witness as _witness
+from sandloom.shared.authz._resolve import (
+    ContractUnavailable,
+    resolve_contract,
+    resolve_org_id,
+)
+from sandloom.shared.authz.account import (
+    _MISSING,
+    Account,
+    _memo,
+    account_org_params,
+    require_account,
+    resolve_account,
+)
+from sandloom.shared.authz.algebra import TIER_CLAIM, TIER_LIVE, Requirement
+from sandloom.shared.authz.metrics import increment
+from sandloom.shared.authz.results import AccessDecision, Category, PolicyIndeterminate
+
+if TYPE_CHECKING:  # pragma: no cover - typing only
+    from collections.abc import Callable
+
+    from sandloom.shared.authz.context import AuthzContext
+
+#: Attribute ``access_check`` puts on the provider method.
+ACCESS_CHECK_ATTR = "__sandloom_access_check__"
+#: Attribute ``AccessFact(atom=...)`` claim classes and contract checks carry.
+ATOM_ATTR = "__sandloom_atom__"
+
+_logger = logging.getLogger("sandloom.access")
+#: PoC switches, set by the stand before the app starts (see module docstring).
+_K5 = False
+_WITNESS = False
+
+#: RPC failure codes that mean "the provider is down", never "untrusted".
+_DOWN_CODES = frozenset({"remote_service_unavailable", "rpc_timeout"})
+
+
+class From:
+    """Where an access check's argument comes from (the kernel's sources)."""
+
+    @staticmethod
+    def subject_id() -> list[Any]:
+        return ["subject"]
+
+    @staticmethod
+    def org(
+        *, param: str | None = "org_id", validate_against_token: bool = True
+    ) -> list[Any]:
+        return ["org", param, bool(validate_against_token)]
+
+    @staticmethod
+    def account_type() -> list[Any]:
+        return ["account_type"]
+
+    @staticmethod
+    def account_id() -> list[Any]:
+        return ["account_id"]
+
+
+_KINDS = frozenset({"subject", "org", "account_type", "account_id"})
+
+
+def access_check(
+    name: str,
+    *,
+    bind: dict[str, list[Any]],
+    category: str = Category.FORBIDDEN,
+    values: dict[str, list[Any]] | None = None,
+    risk: dict[str, dict[str, list[Any]]] | None = None,
+    describe: str | None = None,
+    witnesses_membership: dict[str, Any] | None = None,
+) -> Callable[[Any], Any]:
+    """Declare a boolean contract read method as the access check ``name``.
+
+    ``bind`` maps method parameters to :class:`From` sources; the method's
+    other parameters become the atom's own parameters (``values`` narrows one
+    to a closed set for typing, e.g. ``{"minimum": ["member", "admin",
+    "owner"]}``). ``risk`` is a value table: ``{"admin": {"minimum":
+    ["admin", "owner"]}}`` = the gate carries the ``admin`` risk when every
+    listed parameter has one of the listed values. ``describe`` is the 403
+    label, ``{param}`` placeholders allowed. ``witnesses_membership`` maps
+    the method's parameters to ``"org"``, ``"subject"`` or a constant: an
+    allowing call with the subject's id proves its membership of the
+    organization (tenant kind, owner answer #23).
+    """
+    if not isinstance(name, str) or not name.isidentifier() or not name[0].isupper():
+        raise ValueError(f"access_check name must be a class name, not {name!r}")
+    for arg, source in bind.items():
+        if not isinstance(source, list) or not source or source[0] not in _KINDS:
+            raise ValueError(f"access_check {name}: bind[{arg!r}] is not a From source")
+    spec: dict[str, Any] = {
+        "name": name,
+        "bind": {k: list(v) for k, v in bind.items()},
+        "category": category,
+    }
+    if values:
+        spec["values"] = {k: list(v) for k, v in values.items()}
+    if risk:
+        spec["risk"] = {r: {p: list(v) for p, v in c.items()} for r, c in risk.items()}
+    if describe:
+        spec["describe"] = describe
+    if witnesses_membership:
+        spec["witnesses_membership"] = dict(witnesses_membership)
+
+    def decorate(fn: Any) -> Any:
+        setattr(fn, ACCESS_CHECK_ATTR, spec)
+        return fn
+
+    return decorate
+
+
+def access_check_of(method: Any) -> dict[str, Any] | None:
+    """The :func:`access_check` declaration of a provider method, else ``None``."""
+    func = getattr(method, "__func__", method)
+    spec = getattr(func, ACCESS_CHECK_ATTR, None)
+    return spec if isinstance(spec, dict) else None
+
+
+def _resolve_service(ctx: AuthzContext, name: str, requirement: str) -> Any:
+    try:
+        return resolve_contract(ctx, name)
+    except ContractUnavailable as exc:
+        raise PolicyIndeterminate(
+            AccessDecision.error(
+                code="service_unavailable",
+                category=Category.POLICY_MISCONFIGURED,
+                http_status=501,
+                reason=f"contract {name!r} is not configured",
+                failed_requirement=requirement,
+                metadata={"service": name, "error": str(exc)},
+            )
+        ) from exc
+
+
+def _owner_unavailable(exc: Exception, contract: str, requirement: str) -> Exception:
+    return PolicyIndeterminate(
+        AccessDecision.error(
+            code="owner_unavailable",
+            category=Category.POLICY_MISCONFIGURED,
+            http_status=503,
+            reason=f"contract {contract!r} is unavailable",
+            failed_requirement=requirement,
+            metadata={"service": contract, "error": str(exc)},
+        )
+    )
+
+
+def _required(account: Account | None) -> Account:
+    if account is None:  # pragma: no cover - an account bind sets it in __init__
+        raise TypeError("an account-bound access check needs of=")
+    return account
+
+
+class ContractCheck(Requirement):
+    """The generic evaluator of a generated, contract-anchored atom.
+
+    A generated subclass sets ``__sandloom_atom__`` (``contract``, ``method``,
+    ``args`` in signature order, ``binds``, ``tier``, ``category``, ``risk``,
+    ``describe``, ``values``, ``witness``) and a typed ``__init__`` that calls
+    ``super().__init__(params, of=..., org_param=...)``.
+    """
+
+    __sandloom_atom__: ClassVar[dict[str, Any]] = {}
+    tier = TIER_LIVE
+
+    def __init_subclass__(cls, **kwargs: Any) -> None:
+        super().__init_subclass__(**kwargs)
+        atom = cls.__dict__.get(ATOM_ATTR)
+        if not isinstance(atom, dict) or not atom:
+            return
+        cls.tier = int(atom.get("tier", TIER_LIVE))
+        cls.category = str(atom.get("category", Category.FORBIDDEN))
+        witness = atom.get("witness")
+        if isinstance(witness, dict):
+            order = [a for a in atom["args"] if a in witness]
+            _witness.register_witness(
+                str(atom["contract"]), str(atom["method"]), witness, order
+            )
+
+    def __init__(
+        self,
+        params: dict[str, Any],
+        *,
+        of: Account | None = None,
+        org_param: str | None = None,
+    ) -> None:
+        atom = self.__sandloom_atom__
+        for name, allowed in (atom.get("values") or {}).items():
+            if params.get(name) not in allowed:
+                raise ValueError(
+                    f"{type(self).__name__} {name} must be one of "
+                    f"{', '.join(map(str, allowed))}"
+                )
+        self.params = params
+        self.org_param = org_param
+        kinds = {b[0] for b in atom.get("binds", {}).values()}
+        self.account: Account | None = None
+        if kinds & {"account_type", "account_id"}:
+            self.account = require_account(
+                _MISSING if of is None else of, type(self).__name__
+            )
+        self._args = tuple(atom.get("args", ()))
+        self._binds = dict(atom.get("binds", {}))
+        self._contract = str(atom.get("contract"))
+        self._method = str(atom.get("method"))
+
+    # -- wiring-time metadata (read by require(), create_app, archcheck) -----
+    def org_params(self) -> frozenset[str]:
+        found: set[str] = set()
+        for source in self._binds.values():
+            if source[0] == "org":
+                found.add(self.org_param or source[1] or "")
+        if self.account is not None:
+            found |= account_org_params(self.account)
+        return frozenset(p for p in found if p)
+
+    def contracts(self) -> frozenset[str]:
+        return frozenset({self._contract})
+
+    def needs_request_session(self) -> bool:
+        return False  # the provider runs the call in its own unit
+
+    def risks(self) -> frozenset[str]:
+        out = set()
+        for risk, conditions in (self.__sandloom_atom__.get("risk") or {}).items():
+            if all(self.params.get(p) in vals for p, vals in conditions.items()):
+                out.add(risk)
+        return frozenset(out)
+
+    def describe(self) -> str:
+        template = self.__sandloom_atom__.get("describe")
+        if isinstance(template, str):
+            return template.format(**self.params)
+        return type(self).__name__
+
+    # -- evaluation ----------------------------------------------------------
+    async def evaluate(self, ctx: AuthzContext) -> bool:
+        requirement = self.describe()
+        bound: dict[str, Any] = {}
+        account: tuple[str, UUID] | None = None
+        for arg, source in self._binds.items():
+            kind = source[0]
+            if kind == "subject":
+                bound[arg] = ctx.subject.user_id
+            elif kind == "org":
+                bound[arg] = resolve_org_id(
+                    ctx,
+                    org_param=self.org_param or source[1],
+                    requirement=requirement,
+                    validate_against_token=bool(source[2]),
+                )
+            else:
+                if account is None:
+                    account = await resolve_account(
+                        ctx, _required(self.account), requirement=requirement
+                    )
+                bound[arg] = account[0] if kind == "account_type" else account[1]
+        service = _resolve_service(ctx, self._contract, requirement)
+        args = [bound[a] if a in bound else self.params[a] for a in self._args]
+        if _K5:
+            try:
+                result = await getattr(service, self._method)(*args)
+            except Exception as exc:
+                if getattr(exc, "code", None) in _DOWN_CODES:
+                    # reported even when a sibling branch of an Or allows
+                    _logger.warning(
+                        "access check indeterminate: owner_unavailable (%s, %s)",
+                        requirement,
+                        self._contract,
+                    )
+                    increment(ctx.core(), "access_indeterminate_branch_total")
+                    raise _owner_unavailable(exc, self._contract, requirement) from exc
+                raise
+        else:
+            result = await getattr(service, self._method)(*args)
+        if result and _WITNESS:
+            self._witness(ctx, bound)
+        return bool(result)
+
+    def _witness(self, ctx: AuthzContext, bound: dict[str, Any]) -> None:
+        witness = self.__sandloom_atom__.get("witness")
+        if not isinstance(witness, dict):
+            return
+        org = user = None
+        for arg, source in witness.items():
+            if source == "org":
+                org = bound.get(arg)
+            elif source == "subject":
+                user = bound.get(arg)
+        memo = _memo(ctx.request)
+        if memo is not None and isinstance(org, UUID) and user == ctx.subject.user_id:
+            memo.setdefault(org, "organization")
+
+
+class ClaimFactCheck(Requirement):
+    """The generic evaluator of a generated claim-tier atom (an owner's
+    :class:`AccessFact` with ``atom=``): for ``Account.user()`` it reads the
+    owner's claim under its provenance, zero I/O (today's ``Subscribed``);
+    for an organization account it delegates to the owner's declared access
+    check ``otherwise`` (live, today's ``SubscriptionActive``)."""
+
+    __sandloom_atom__: ClassVar[dict[str, Any]] = {}
+    tier = TIER_CLAIM
+    _otherwise: ClassVar[type[ContractCheck] | None] = None
+
+    def __init_subclass__(cls, **kwargs: Any) -> None:
+        super().__init_subclass__(**kwargs)
+        atom = cls.__dict__.get(ATOM_ATTR)
+        if not isinstance(atom, dict) or not atom:
+            return
+        cls.category = str(atom.get("category") or Category.FORBIDDEN)
+        otherwise = atom.get("otherwise")
+        if isinstance(otherwise, dict):
+            cls._otherwise = type(  # a ContractCheck from the owner's literal
+                f"{cls.__name__}Live", (ContractCheck,), {ATOM_ATTR: otherwise}
+            )
+
+    def __init__(self, *, of: Account = _MISSING) -> None:
+        self.account = require_account(of, type(self).__name__)
+        if self.account.kind != "user":
+            self.tier = TIER_LIVE
+
+    def org_params(self) -> frozenset[str]:
+        return account_org_params(self.account)
+
+    def contracts(self) -> frozenset[str]:
+        atom = self.__sandloom_atom__
+        needed = {f"{atom['owner']}.facts.v1"}
+        if self.account.kind != "user" and self._otherwise is not None:
+            needed.add(str(self._otherwise.__sandloom_atom__["contract"]))
+        return frozenset(needed)
+
+    def describe(self) -> str:
+        return str(self.__sandloom_atom__.get("describe") or type(self).__name__)
+
+    def _indeterminate(self, code: str, reason: str, status: int) -> Exception:
+        return PolicyIndeterminate(
+            AccessDecision.error(
+                code=code,
+                category=Category.POLICY_MISCONFIGURED,
+                http_status=status,
+                reason=reason,
+                failed_requirement=self.describe(),
+            )
+        )
+
+    async def evaluate(self, ctx: AuthzContext) -> bool:
+        if self.account.kind != "user":
+            tenant_type, _tenant = await resolve_account(
+                ctx, self.account, requirement=self.describe()
+            )
+            if tenant_type != "user":
+                if self._otherwise is None:
+                    raise self._indeterminate(
+                        "no_live_check", "no organization check declared", 501
+                    )
+                return await self._otherwise({}, of=self.account).evaluate(ctx)
+        return await self._via_fact(ctx)
+
+    async def _via_fact(self, ctx: AuthzContext) -> bool:
+        atom = self.__sandloom_atom__
+        status = ctx.subject.claim(str(atom["claim_key"]))
+        try:
+            fact = await _facts.lookup_access_fact(
+                ctx, str(atom["fact"]), owner=str(atom["owner"])
+            )
+        except _facts.FactOwnerUnreachable as exc:
+            raise self._indeterminate("fact_owner_unavailable", str(exc), 503) from exc
+        if fact is None:
+            # The owner is neither local nor bound: nobody may vouch for the
+            # claim (today's kernel fell back to its own status list).
+            raise self._indeterminate(
+                "fact_unregistered",
+                f"access fact {atom['fact']!r}: its owner {atom['owner']!r} is "
+                "not deployed",
+                501,
+            )
+        if (
+            _facts._claim_trustworthy(fact, ctx)
+            or not ctx.subject.provenance_authoritative
+        ):
+            return fact.interpret_claim(status)
+        try:
+            return await _facts.resolve_fact(fact, ctx, mode=_facts.MODE_LIVE)
+        except _facts.FactDenied:
+            return False
+        except _facts.FactUnavailable as exc:
+            raise self._indeterminate(
+                "subscription_unverifiable",
+                f"claim not minted by {fact.owner_module!r} and no live check is "
+                f"available: {exc}",
+                503,
+            ) from exc
+
+
+__all__ = [
+    "ACCESS_CHECK_ATTR",
+    "ATOM_ATTR",
+    "Account",
+    "ClaimFactCheck",
+    "ContractCheck",
+    "From",
+    "access_check",
+    "access_check_of",
+]
