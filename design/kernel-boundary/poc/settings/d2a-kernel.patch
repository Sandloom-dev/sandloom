diff --git a/src/sandloom/core/config/module_settings.py b/src/sandloom/core/config/module_settings.py
new file mode 100644
index 0000000..40f988b
--- /dev/null
+++ b/src/sandloom/core/config/module_settings.py
@@ -0,0 +1,743 @@
+"""Module-declared settings (ADR-0015, D2a) — KB-49 PoC prototype.
+
+A module hands a plain pydantic model to its registration
+(``define_module(..., settings=Model)`` or ``api.settings(Model)``). The
+loader validates it from the process source snapshot before ``setup`` runs,
+stores the instance on the core, and ``settings_of(Model)`` reads it. One
+post-load check runs after the load pass (collisions, risk namespaces,
+removed settings, the typo check over the union, override reporting).
+
+Metadata are class attributes holding the kernel's existing dataclasses::
+
+    semantic = (SemanticSetting(...),)
+    risks = (Risk(...),)            # ids are local names; full id <module>.<name>
+    removed = (RemovedSetting(...),)
+    shared = frozenset({"INVENTORY_..."})
+    console = ("INVENTORY_...",)
+    backup = {"INVENTORY_SECRET": "why it must be backed up"}
+
+Production checks are ``model_validator``s reading ``info.context``:
+``environment`` (str), ``accepts_risk`` (callable, local or full id),
+``kernel`` (the kernel ``Settings``, read only by convention).
+
+Pure configuration layer: imports nothing above ``sandloom.core.config``.
+"""
+
+from __future__ import annotations
+
+import contextvars
+import json
+import logging
+import os
+from collections import Counter
+from collections.abc import Callable, Iterable, Iterator, Mapping
+from contextlib import contextmanager
+from dataclasses import dataclass, field
+from difflib import get_close_matches
+from importlib import metadata
+from pathlib import Path
+from typing import Any, TypeVar
+
+from pydantic import BaseModel, ValidationError
+
+from sandloom.core.config import accepted_risks as _risks
+from sandloom.core.config.common import INVALID_CONFIGURATION, ConfigurationError
+from sandloom.core.config.tiers import (
+    NO_OPINION,
+    RemovedSetting,
+    SemanticSetting,
+    removed_setting_problem,
+)
+
+logger = logging.getLogger("sandloom.settings")
+
+M = TypeVar("M", bound=BaseModel)
+
+#: SANDLOOM-B036 (proposed): one env name declared twice.
+COLLISION_CODE = "SANDLOOM-B036"
+
+
+class ModuleSettingsError(ConfigurationError):
+    """A module's settings are invalid (fatal for an optional module too)."""
+
+
+# --------------------------------------------------------------- snapshot ----
+
+#: P7 spy: how often each source was read in this process.
+STATS: dict[str, Any] = {"dotenv_parses": 0, "secrets_lookups": Counter()}
+
+
+class SourceSnapshot:
+    """One frozen, case-insensitive read of env > ``.env`` > ``SECRETS_DIR``.
+
+    ``.env`` is parsed once; ``SECRETS_DIR`` is never listed, each declared
+    alias is looked up once (cached). ``origin(name)`` is the source that
+    supplied it (``env`` / ``dotenv`` / ``secrets_dir``) or ``None``.
+    """
+
+    def __init__(self, env_file: str | None = ".env") -> None:
+        self._env = {str(k).upper(): v for k, v in os.environ.items()}
+        self._dotenv: dict[str, str] = {}
+        if env_file and Path(env_file).is_file():
+            from dotenv import dotenv_values
+
+            STATS["dotenv_parses"] += 1
+            self._dotenv = {
+                str(k).upper(): v
+                for k, v in dotenv_values(env_file).items()
+                if v is not None
+            }
+        secrets_dir = self._env.get("SECRETS_DIR") or self._dotenv.get("SECRETS_DIR")
+        self._secrets_dir = Path(secrets_dir) if secrets_dir else None
+        self._secrets: dict[str, str | None] = {}
+
+    def _secret(self, name: str) -> str | None:
+        if self._secrets_dir is None:
+            return None
+        if name not in self._secrets:
+            STATS["secrets_lookups"][name] += 1
+            value = None
+            for candidate in (name, name.lower()):
+                path = self._secrets_dir / candidate
+                if path.is_file():
+                    value = path.read_text().strip()
+                    break
+            self._secrets[name] = value
+        return self._secrets[name]
+
+    def get(self, name: str) -> tuple[str | None, str | None]:
+        key = name.upper()
+        if key in self._env:
+            return self._env[key], "env"
+        if key in self._dotenv:
+            return self._dotenv[key], "dotenv"
+        value = self._secret(key)
+        if value is not None:
+            return value, "secrets_dir"
+        return None, None
+
+    def origin(self, name: str) -> str | None:
+        return self.get(name)[1]
+
+    def present(self) -> set[str]:
+        """Names supplied by env or ``.env`` (secrets are never listed)."""
+        return set(self._env) | set(self._dotenv)
+
+    def merged(self, declared: Iterable[str]) -> dict[str, str]:
+        """``{lowercase name: value}`` for a pydantic-settings env source:
+        every env / ``.env`` key plus a secrets lookup per declared alias."""
+        out: dict[str, str] = {}
+        for name in declared:
+            value = self._secret(name.upper())
+            if value is not None:
+                out[name.lower()] = value
+        out.update({k.lower(): v for k, v in self._dotenv.items()})
+        out.update({k.lower(): v for k, v in self._env.items()})
+        return out
+
+
+_PROCESS_SNAPSHOT: SourceSnapshot | None = None
+
+
+def set_process_snapshot(snapshot: SourceSnapshot) -> None:
+    global _PROCESS_SNAPSHOT
+    _PROCESS_SNAPSHOT = snapshot
+
+
+def process_snapshot() -> SourceSnapshot:
+    """The snapshot the process settings were loaded from (built on demand)."""
+    global _PROCESS_SNAPSHOT
+    if _PROCESS_SNAPSHOT is None:
+        _PROCESS_SNAPSHOT = SourceSnapshot()
+    return _PROCESS_SNAPSHOT
+
+
+# ------------------------------------------------------------ declarations ----
+
+
+def env_names(model: type[BaseModel]) -> dict[str, str]:
+    """``{ENV_NAME: field name}`` of a declared model."""
+    out: dict[str, str] = {}
+    for name, info in model.model_fields.items():
+        alias = (
+            info.validation_alias if isinstance(info.validation_alias, str) else None
+        )
+        out[str(alias or info.alias or name).upper()] = name
+    return out
+
+
+def declared_risks(model: type[BaseModel]) -> tuple[_risks.Risk, ...]:
+    return tuple(getattr(model, "risks", ()) or ())
+
+
+def declared_semantic(model: type[BaseModel]) -> tuple[SemanticSetting, ...]:
+    return tuple(getattr(model, "semantic", ()) or ())
+
+
+def declared_removed(model: type[BaseModel]) -> tuple[RemovedSetting, ...]:
+    return tuple(getattr(model, "removed", ()) or ())
+
+
+def is_secret_field(model: type[BaseModel], field_name: str) -> bool:
+    from pydantic import SecretStr
+
+    annotation = model.model_fields[field_name].annotation
+    text = repr(annotation)
+    return annotation is SecretStr or "SecretStr" in text
+
+
+@dataclass
+class ModuleSettingsRecord:
+    module: str  # short name (billing, inventory)
+    package: str
+    model: type[BaseModel]
+    instance: BaseModel | None
+    origins: dict[str, str | None] = field(default_factory=dict)
+    problem: str | None = None
+
+
+# ------------------------------------------------------------ collect mode ----
+
+#: Set by ``config dump`` / doctor before the composition root is imported.
+#: Never read from the environment (adversarial D-1).
+COLLECT: contextvars.ContextVar[list[str] | None] = contextvars.ContextVar(
+    "sandloom_settings_collect", default=None
+)
+
+
+@contextmanager
+def collect_mode() -> Iterator[list[str]]:
+    problems: list[str] = []
+    token = COLLECT.set(problems)
+    try:
+        yield problems
+    finally:
+        COLLECT.reset(token)
+
+
+class CollectedSettingsProblem(Exception):
+    """Collect mode: a module's settings error, recorded instead of exiting."""
+
+
+# -------------------------------------------------------------- validation ----
+
+
+def _format(error: ValidationError, names: Mapping[str, str]) -> str:
+    by_field = {v: k for k, v in names.items()}
+    parts = []
+    for item in error.errors(include_input=False):
+        loc = item.get("loc") or ()
+        msg = str(item.get("msg", "invalid"))
+        msg = msg.removeprefix("Value error, ")
+        if loc:
+            head = str(loc[0])
+            alias = head.upper() if head.upper() in names else by_field.get(head, head)
+            parts.append(f"{alias}: {msg}")
+        else:
+            parts.append(msg)
+    return "; ".join(parts)
+
+
+def _accepts_risk_for(
+    module: str, model: type[BaseModel], kernel: Any
+) -> Callable[[str], bool]:
+    local = {r.id for r in declared_risks(model)}
+    accepted = set(getattr(kernel, "sandloom_accepted_risks", None) or ())
+
+    def accepts_risk(risk_id: str) -> bool:
+        name = risk_id.split(".", 1)[1] if risk_id.startswith(f"{module}.") else risk_id
+        if "." in name or name not in local:
+            raise KeyError(f"{module} declares no risk {risk_id!r}")
+        return f"{module}.{name}" in accepted
+
+    return accepts_risk
+
+
+def _raw_values(
+    model: type[BaseModel], snapshot: SourceSnapshot
+) -> tuple[dict[str, Any], dict[str, str | None]]:
+    data: dict[str, Any] = {}
+    origins: dict[str, str | None] = {}
+    for alias, name in env_names(model).items():
+        value, origin = snapshot.get(alias)
+        origins[alias] = origin
+        if value is None:
+            continue
+        annotation = repr(model.model_fields[name].annotation)
+        text = value.strip()
+        if text[:1] in "[{" and (
+            "list" in annotation
+            or "dict" in annotation
+            or "tuple" in annotation
+            or "set" in annotation
+        ):
+            try:
+                data[alias] = json.loads(text)
+                continue
+            except ValueError:
+                pass
+        data[alias] = value
+    return data, origins
+
+
+def validate_module_settings(
+    module: str,
+    package: str,
+    model: type[M],
+    kernel: Any,
+    snapshot: SourceSnapshot | None = None,
+) -> ModuleSettingsRecord:
+    """Validate ``model`` from the snapshot with the module's context."""
+    snap = snapshot or process_snapshot()
+    data, origins = _raw_values(model, snap)
+    environment = getattr(getattr(kernel, "environment", None), "value", None) or str(
+        getattr(kernel, "environment", "dev")
+    )
+    context = {
+        "environment": environment,
+        "accepts_risk": _accepts_risk_for(module, model, kernel),
+        "kernel": kernel,
+        "module": module,
+    }
+    try:
+        instance = model.model_validate(data, context=context)
+    except ValidationError as exc:
+        reason = _format(exc, env_names(model))
+        message = f"{INVALID_CONFIGURATION}module {package}: {reason}"
+        collected = COLLECT.get()
+        if collected is not None:
+            collected.append(message)
+            return ModuleSettingsRecord(module, package, model, None, origins, message)
+        raise ModuleSettingsError(message) from None
+    return ModuleSettingsRecord(module, package, model, instance, origins)
+
+
+def module_short_name(package: str) -> str:
+    by_package = {pkg: name for name, pkg in installed_module_names().items()}
+    return by_package.get(package) or package.rsplit(".", 1)[-1]
+
+
+def declare(core: Any, package: str, model: type[M], kernel: Any) -> M | None:
+    """``api.declare_settings(Model)``: validate now, store on the core, return it."""
+
+    module = module_short_name(package)
+
+    record = validate_module_settings(module, package, model, kernel)
+    registry: dict[str, ModuleSettingsRecord] = core.__dict__.setdefault(
+        "_module_settings", {}
+    )
+    registry[module] = record
+    if record.instance is None:
+        raise CollectedSettingsProblem(record.problem)
+    return record.instance  # type: ignore[return-value]
+
+
+def records(core: Any) -> dict[str, ModuleSettingsRecord]:
+    return dict(getattr(core, "_module_settings", {}) or {})
+
+
+# ----------------------------------------------------------------- readers ----
+
+_OVERRIDES: contextvars.ContextVar[dict[type[BaseModel], BaseModel] | None] = (
+    contextvars.ContextVar("sandloom_settings_overrides", default=None)
+)
+_LOADING: contextvars.ContextVar[Any] = contextvars.ContextVar(
+    "sandloom_settings_loading_core", default=None
+)
+
+
+@contextmanager
+def loading(core: Any) -> Iterator[None]:
+    token = _LOADING.set(core)
+    try:
+        yield
+    finally:
+        _LOADING.reset(token)
+
+
+#: The active-core lookup, installed by ``sandloom.core.module_api`` (the
+#: configuration layer imports nothing above it, ADR-0007).
+ACTIVE_CORE: Callable[[], Any] | None = None
+
+
+class SettingsNotBoundError(RuntimeError):
+    """``settings_of`` with no application bound (e.g. at import time)."""
+
+
+#: ``patch_settings`` (monkeypatch-scoped test overrides).
+_PATCHED: dict[type[BaseModel], BaseModel] = {}
+
+
+def settings_of(model: type[M]) -> M:
+    """The validated instance of ``model`` in the bound application."""
+    overrides = _OVERRIDES.get()
+    if overrides and model in overrides:
+        return overrides[model]  # type: ignore[return-value]
+    if model in _PATCHED:
+        return _PATCHED[model]  # type: ignore[return-value]
+    core = _LOADING.get()
+    if core is None and ACTIVE_CORE is not None:
+        core = ACTIVE_CORE()
+    if core is None:
+        raise SettingsNotBoundError(
+            f"settings_of({model.__name__}) with no application bound: read "
+            "settings inside a request, task or setup, never at import"
+        )
+    for record in records(core).values():
+        if record.model is model and record.instance is not None:
+            return record.instance  # type: ignore[return-value]
+    raise SettingsNotBoundError(
+        f"settings_of({model.__name__}): no loaded module declared this model"
+    )
+
+
+def patch_settings(monkeypatch: Any, model: type[M], **values: Any) -> M:
+    """Testing override for the test's ``monkeypatch`` scope: ``settings_of``
+    returns the current instance (or the model's defaults with no app) with
+    ``values`` (field names) applied. Repeated calls accumulate."""
+    try:
+        base = settings_of(model)
+    except SettingsNotBoundError:
+        base = model.model_construct()
+    instance = base.model_copy(update=values)
+    monkeypatch.setitem(_PATCHED, model, instance)
+    return instance
+
+
+def reset_process_snapshot(monkeypatch: Any) -> None:
+    """Testing: re-read the process snapshot from the (monkeypatched)
+    environment for the test's scope (it is read once per process)."""
+    monkeypatch.setattr(
+        __import__(__name__, fromlist=["_"]),
+        "_PROCESS_SNAPSHOT",
+        SourceSnapshot(env_file=None),
+    )
+
+
+def validate_settings(model: type[M], kernel: Any) -> M:
+    """Testing: validate ``model`` from the process snapshot exactly as the
+    loader does before ``setup`` (raises :class:`ModuleSettingsError`)."""
+    package = str(model.__module__).split(".", 1)[0]
+    record = validate_module_settings(
+        module_short_name(package), package, model, kernel
+    )
+    return record.instance  # type: ignore[return-value]
+
+
+@contextmanager
+def override_settings(model: type[M], **values: Any) -> Iterator[M]:
+    """Testing override: ``settings_of(model)`` returns a copy with ``values``
+    (field names) for the scope; the kernel singleton is untouched."""
+    try:
+        base = settings_of(model)
+        instance = base.model_copy(update=values)
+    except SettingsNotBoundError:
+        instance = model.model_construct(**values)
+    current = dict(_OVERRIDES.get() or {})
+    current[model] = instance
+    token = _OVERRIDES.set(current)
+    try:
+        yield instance
+    finally:
+        _OVERRIDES.reset(token)
+
+
+# ------------------------------------------------------- known namespaces ----
+
+
+_INSTALLED: dict[str, str] | None = None
+
+
+def installed_module_names() -> dict[str, str]:
+    """K1: ``{entry-point name: package}`` of the installed modules (read
+    once per process: the installed distributions do not change while it runs)."""
+    global _INSTALLED
+    if _INSTALLED is None:
+        _INSTALLED = _scan_installed()
+    return dict(_INSTALLED)
+
+
+def _scan_installed() -> dict[str, str]:
+    return {
+        ep.name: str(ep.value).split(":", 1)[0].strip()
+        for ep in metadata.entry_points().select(group="sandloom.modules")
+    }
+
+
+def _installed_declaration(package: str) -> type[BaseModel] | None:
+    """The settings model an installed module declares (import only)."""
+    import importlib
+
+    try:
+        mod = importlib.import_module(package)
+    except Exception:  # noqa: BLE001 - a broken install names nothing
+        return None
+    register = getattr(mod, "register", None)
+    model = getattr(register, "__sandloom_settings__", None)
+    return model if isinstance(model, type) and issubclass(model, BaseModel) else None
+
+
+def flat_id_replacement(risk_id: str) -> str | None:
+    """Option (ii) of alternatives-d §6.1: the namespaced id an installed
+    module declares for a flat id (imports the declarations, no register)."""
+    for name, package in sorted(installed_module_names().items()):
+        model = _installed_declaration(package)
+        if model is None:
+            continue
+        if any(r.id == risk_id for r in declared_risks(model)):
+            return f"{name}.{risk_id}"
+    return None
+
+
+def flat_risk_problem(ids: Iterable[str]) -> str | None:
+    """Kernel ``Settings`` validator: a flat id that is not a kernel id."""
+    for risk_id in sorted({str(i) for i in ids}):
+        if "." in risk_id or risk_id in _risks.RISK_IDS:
+            continue
+        replacement = flat_risk_hint(risk_id)
+        return (
+            f"SANDLOOM_ACCEPTED_RISKS names unknown risk id {risk_id!r}; {replacement}"
+        )
+    return None
+
+
+def flat_risk_hint(risk_id: str) -> str:
+    replacement = flat_id_replacement(risk_id)
+    if replacement:
+        return (
+            f"module risk ids are namespaced: use {replacement!r} "
+            "(docs/upgrade notes: accepted-risk ids)"
+        )
+    return (
+        "module risk ids are namespaced <module>.<id> since the settings "
+        f"migration (see the upgrade notes); kernel ids: {sorted(_risks.RISK_IDS)}"
+    )
+
+
+# -------------------------------------------------------- post-load check ----
+
+
+@dataclass
+class LoadedSettingsState:
+    """What the post-load check found (diagnostics, doctor, overrides)."""
+
+    module_risks: dict[str, _risks.Risk] = field(default_factory=dict)
+    not_applicable: list[str] = field(default_factory=list)
+    records: dict[str, ModuleSettingsRecord] = field(default_factory=dict)
+
+
+#: The last composition checked in this process (I-24: one app per process
+#: outside tests; tests rebuild it with each app).
+STATE = LoadedSettingsState()
+
+
+def _kernel_names(kernel_cls: Any) -> set[str]:
+    return {
+        str(info.alias or name).upper()
+        for name, info in kernel_cls.model_fields.items()
+    }
+
+
+def app_local_modules(kernel: Any) -> set[str]:
+    """Short names of the app-local modules the composition names
+    (``SANDLOOM_MODULES`` entries that are not entry points)."""
+    by_package = {pkg: name for name, pkg in installed_module_names().items()}
+    names = set()
+    for entry in getattr(kernel, "sandloom_modules", None) or ():
+        text = str(entry)
+        names.add(by_package.get(text) or text.rsplit(".", 1)[-1])
+    return names
+
+
+def post_load_check(
+    core: Any, loaded_names: Iterable[str], kernel: Any
+) -> LoadedSettingsState:
+    """ADR-0015 decision 3: the one check after the load pass."""
+    Settings = type(kernel)
+
+    snap = process_snapshot()
+    regs = {m: r for m, r in records(core).items()}
+    problems: list[str] = []
+
+    # 1. collisions (kernel and loaded modules)
+    owners: dict[str, str] = dict.fromkeys(_kernel_names(Settings), "kernel")
+    for module, record in sorted(regs.items()):
+        for name in env_names(record.model):
+            if name in owners:
+                problems.append(
+                    f"{COLLISION_CODE}: {name} is declared by {owners[name]} and "
+                    f"module {module}"
+                )
+            else:
+                owners[name] = f"module {module}"
+
+    # 2. accepted-risk namespaces
+    loaded = set(regs) | {str(n) for n in loaded_names}
+    known = set(installed_module_names()) | loaded | app_local_modules(kernel)
+    module_risks: dict[str, _risks.Risk] = {}
+    for module, record in regs.items():
+        for item in declared_risks(record.model):
+            module_risks[f"{module}.{item.id}"] = item
+    not_applicable: list[str] = []
+    for risk_id in sorted(getattr(kernel, "sandloom_accepted_risks", None) or ()):
+        if "." not in risk_id:
+            continue  # flat: the kernel validator already judged it
+        ns, _, _name = risk_id.partition(".")
+        if ns in regs:
+            if risk_id not in module_risks:
+                declared = sorted(k for k in module_risks if k.startswith(f"{ns}."))
+                problems.append(
+                    f"SANDLOOM_ACCEPTED_RISKS names {risk_id!r}, which module "
+                    f"{ns} does not declare (declared: {declared})"
+                )
+        elif ns in known:
+            not_applicable.append(risk_id)
+        else:
+            problems.append(
+                f"SANDLOOM_ACCEPTED_RISKS names {risk_id!r}: no module {ns!r} is "
+                f"known in this deployment (installed or loaded: {sorted(known)})"
+            )
+
+    # 3. removed settings of loaded modules
+    for module, record in sorted(regs.items()):
+        for removed in declared_removed(record.model):
+            raw, _origin = snap.get(removed.name)
+            if raw is None:
+                continue
+            problem, fatal = removed_setting_problem(removed, raw)
+            if fatal:
+                problems.append(f"module {module}: {problem}")
+            else:
+                logger.warning(problem)
+
+    # 4. production typo check over the union
+    if getattr(kernel, "is_prod", False):
+        aliases = set(owners)
+        prefixes = {n.split("_", 1)[0] for n in aliases if "_" in n}
+        for key in sorted(snap.present()):
+            if key in aliases or len(key) < 8 or "_" not in key:
+                continue
+            if key.split("_", 1)[0] not in prefixes:
+                continue
+            matches = get_close_matches(key, sorted(aliases), n=1, cutoff=0.95)
+            if matches:
+                problems.append(f"Unknown setting {key}; did you mean {matches[0]}?")
+
+    if problems:
+        message = f"{INVALID_CONFIGURATION}" + "; ".join(problems)
+        collected = COLLECT.get()
+        if collected is None:
+            raise ModuleSettingsError(message)
+        collected.append(message)
+
+    STATE.module_risks = module_risks
+    STATE.not_applicable = not_applicable
+    STATE.records = regs
+    _risks.set_module_risks(module_risks, not_applicable)
+    return STATE
+
+
+def is_module_override(item: Any) -> bool:
+    """An override the post-load report already logged (module-owned)."""
+    if item.kind == "accepted_risk":
+        return "." in str(item.value)
+    return any(item.setting in env_names(r.model) for r in STATE.records.values())
+
+
+def module_override_items(kernel: Any) -> list[Any]:
+    """The module-owned overrides and accepted risks as tiers.Override."""
+    from sandloom.core.config import tiers
+
+    return [o for o in tiers.active_overrides(kernel) if is_module_override(o)]
+
+
+# --------------------------------------------------- overrides (tiers) ----
+
+
+def _profile_value(spec: SemanticSetting, prof: str) -> object:
+    return spec.profile.get(prof, NO_OPINION)
+
+
+def module_overrides(kernel: Any) -> list[tuple[str, object, str, object, bool]]:
+    """``(setting, value, profile, profile value, explicit)`` for each module
+    semantic setting weaker than its profile value (a risk it names that is
+    accepted reports as the risk instead)."""
+    from sandloom.core.config.tiers import profile_of
+
+    prof = profile_of(kernel)
+    out = []
+    for module, record in sorted(STATE.records.items()):
+        if record.instance is None:
+            continue
+        names = env_names(record.model)
+        for spec in declared_semantic(record.model):
+            if spec.risk is not None:
+                full = spec.risk if "." in spec.risk else f"{module}.{spec.risk}"
+                if full in (getattr(kernel, "sandloom_accepted_risks", None) or ()):
+                    continue
+            field_name = names.get(spec.name)
+            if field_name is None:
+                continue
+            value = (
+                spec.effective(record.instance)
+                if spec.effective is not None
+                else getattr(record.instance, field_name)
+            )
+            expected = _profile_value(spec, prof)
+            if expected is not NO_OPINION and spec.weaker(value, expected):
+                explicit = record.origins.get(spec.name) is not None
+                out.append((spec.name, value, prof, expected, explicit))
+    return out
+
+
+def module_tiers(model: type[BaseModel]) -> dict[str, str]:
+    """``{ENV_NAME: tier}`` of a declared model (undeclared fields are ops)."""
+    semantic = {s.name for s in declared_semantic(model)}
+    return {
+        name: ("semantic" if name in semantic else "ops")
+        for name in sorted(env_names(model))
+    }
+
+
+def _module_tier_counts() -> dict[str, dict[str, int]]:
+    out: dict[str, dict[str, int]] = {}
+    for module, record in sorted(STATE.records.items()):
+        tiers_of = module_tiers(record.model)
+        out[module] = {
+            "semantic": sum(1 for t in tiers_of.values() if t == "semantic"),
+            "ops": sum(1 for t in tiers_of.values() if t == "ops"),
+        }
+    return out
+
+
+# tiers reads the loaded modules through hooks (no import cycle in config).
+from sandloom.core.config import tiers as _tiers  # noqa: E402
+
+_tiers.MODULE_OVERRIDES = module_overrides
+_tiers.MODULE_TIER_COUNTS = _module_tier_counts
+
+
+__all__ = [
+    "COLLECT",
+    "COLLISION_CODE",
+    "CollectedSettingsProblem",
+    "ModuleSettingsError",
+    "ModuleSettingsRecord",
+    "STATE",
+    "STATS",
+    "SettingsNotBoundError",
+    "SourceSnapshot",
+    "collect_mode",
+    "declare",
+    "env_names",
+    "flat_risk_problem",
+    "module_overrides",
+    "module_tiers",
+    "override_settings",
+    "patch_settings",
+    "post_load_check",
+    "process_snapshot",
+    "records",
+    "settings_of",
+    "validate_module_settings",
+]
