diff --git a/src/sandloom_billing/settings.py b/src/sandloom_billing/settings.py
new file mode 100644
index 0000000..a3c7ab9
--- /dev/null
+++ b/src/sandloom_billing/settings.py
@@ -0,0 +1,129 @@
+"""Billing's declared settings (ADR-0015 D2a; KB-49 PoC port).
+
+Env names are byte-identical to the former kernel fields (answer #30); the
+unprefixed ``STRIPE_*`` names are grandfathered by the module snapshot.
+"""
+
+from __future__ import annotations
+
+from typing import Any, ClassVar, Literal
+
+from pydantic import BaseModel, Field, SecretStr, ValidationInfo, model_validator
+
+from sandloom.sdk.module import RemovedSetting, Risk, SemanticSetting, settings_of
+
+
+class BillingSettings(BaseModel):
+    """Payment provider and billing policy."""
+
+    billing_provider: Literal["fake", "stripe"] = Field(
+        default="fake",
+        alias="BILLING_PROVIDER",
+        description="Payment provider: fake (local / tests) or stripe.",
+    )
+    stripe_secret_key: SecretStr | None = Field(
+        default=None, alias="STRIPE_SECRET_KEY", description="Stripe API secret."
+    )
+    stripe_webhook_secret: SecretStr | None = Field(
+        default=None,
+        alias="STRIPE_WEBHOOK_SECRET",
+        description="Stripe webhook signing secret.",
+    )
+    billing_deny_on_past_due: bool = Field(
+        default=False,
+        alias="BILLING_DENY_ON_PAST_DUE",
+        description="Deny entitlements while payment is past due.",
+    )
+    billing_grant_intentless_subscriptions: bool = Field(
+        default=False,
+        alias="BILLING_GRANT_INTENTLESS_SUBSCRIPTIONS",
+        description="Catalog subscriptions without an operation intent grant access.",
+    )
+    billing_intent_reconcile_after_minutes: int = Field(
+        default=30, ge=5, le=24 * 60, alias="BILLING_INTENT_RECONCILE_AFTER_MINUTES"
+    )
+    billing_intent_reconcile_max_attempts: int = Field(
+        default=5, ge=1, le=100, alias="BILLING_INTENT_RECONCILE_MAX_ATTEMPTS"
+    )
+    billing_portal_attribution_window_minutes: int = Field(
+        default=60, ge=1, le=24 * 60, alias="BILLING_PORTAL_ATTRIBUTION_WINDOW_MINUTES"
+    )
+
+    semantic: ClassVar[tuple[SemanticSetting, ...]] = (
+        SemanticSetting(
+            "BILLING_GRANT_INTENTLESS_SUBSCRIPTIONS",
+            "A subscription without an operation intent grants entitlements.",
+            profile=dict.fromkeys(("dev", "test", "prod", "prod_strict"), False),
+            strength=(True, False),
+        ),
+    )
+    risks: ClassVar[tuple[Risk, ...]] = (
+        Risk(
+            "fake_psp_in_prod",
+            "BILLING_PROVIDER=fake with ENVIRONMENT=prod: fake checkout "
+            "sessions, no real payment (demo stacks).",
+            "billing's production check (sandloom_billing.settings)",
+        ),
+    )
+    removed: ClassVar[tuple[RemovedSetting, ...]] = (
+        RemovedSetting(
+            "BILLING_FAKE_ALLOW_UNSIGNED_WEBHOOKS",
+            "0.8",
+            "the fake PSP always rejects unsigned webhooks; sign test payloads "
+            "with sandloom_billing.psp.sign_stripe_payload",
+        ),
+        RemovedSetting(
+            "BILLING_ALLOW_FAKE_PSP_IN_PROD",
+            "0.8",
+            "accept the risk explicitly: "
+            'SANDLOOM_ACCEPTED_RISKS=["billing.fake_psp_in_prod"]',
+        ),
+    )
+    shared: ClassVar[frozenset[str]] = frozenset({"BILLING_DENY_ON_PAST_DUE"})
+    console: ClassVar[tuple[str, ...]] = ("BILLING_PROVIDER",)
+    dev_env: ClassVar[dict[str, str]] = {"BILLING_PROVIDER": "fake"}
+    dev_accepted_risks: ClassVar[tuple[str, ...]] = ("fake_psp_in_prod",)
+    backup: ClassVar[dict[str, str]] = {
+        "STRIPE_WEBHOOK_SECRET": "webhooks in flight verify with it"
+    }
+
+    @model_validator(mode="after")
+    def _stripe_keys(self) -> BillingSettings:
+        if self.billing_provider == "stripe":
+            missing = [
+                name
+                for name, value in (
+                    ("STRIPE_SECRET_KEY", self.stripe_secret_key),
+                    ("STRIPE_WEBHOOK_SECRET", self.stripe_webhook_secret),
+                )
+                if not value
+            ]
+            if missing:
+                raise ValueError(
+                    f"BILLING_PROVIDER=stripe requires variables: {', '.join(missing)}"
+                )
+        return self
+
+    @model_validator(mode="after")
+    def _no_fake_psp_in_prod(self, info: ValidationInfo) -> BillingSettings:
+        ctx: dict[str, Any] = info.context or {}
+        if (
+            ctx.get("environment") == "prod"
+            and self.billing_provider == "fake"
+            and not ctx["accepts_risk"]("fake_psp_in_prod")
+        ):
+            raise ValueError(
+                "BILLING_PROVIDER=fake is not allowed with ENVIRONMENT=prod: set "
+                "BILLING_PROVIDER=stripe with STRIPE_SECRET_KEY and "
+                "STRIPE_WEBHOOK_SECRET (or, for a demo stack, "
+                'SANDLOOM_ACCEPTED_RISKS=["billing.fake_psp_in_prod"])'
+            )
+        return self
+
+
+def billing_settings() -> BillingSettings:
+    """Billing's validated settings in the bound application."""
+    return settings_of(BillingSettings)
+
+
+__all__ = ["BillingSettings", "billing_settings"]
