diff --git a/src/sandloom_identity/config.py b/src/sandloom_identity/config.py
new file mode 100644
index 0000000..bf464c6
--- /dev/null
+++ b/src/sandloom_identity/config.py
@@ -0,0 +1,65 @@
+"""Identity's declared settings (ADR-0015 D2a; KB-49 PoC port: the TOTP key).
+
+The SSO / Telegram / refresh-session names stay kernel fields in this PoC
+(not needed by any P-row); KB-53 moves them.
+"""
+
+from __future__ import annotations
+
+from typing import Any, ClassVar
+
+from pydantic import BaseModel, Field, SecretStr, ValidationInfo, model_validator
+
+from sandloom.sdk.module import secret_problem, settings_of
+
+
+class IdentitySettings(BaseModel):
+    twofa_encryption_key: SecretStr | None = Field(
+        default=None,
+        alias="TWOFA_ENCRYPTION_KEY",
+        description=(
+            "Comma-separated TOTP encryption keys, newest first; required in "
+            "production, derived from JWT_SECRET elsewhere."
+        ),
+    )
+
+    dev_env: ClassVar[dict[str, str]] = {"TWOFA_ENCRYPTION_KEY": "random_hex32"}
+    backup: ClassVar[dict[str, str]] = {
+        "TWOFA_ENCRYPTION_KEY": (
+            "every key still in the list: losing it makes every 2FA secret "
+            "undecryptable"
+        )
+    }
+
+    def keys(self) -> list[str]:
+        raw = (
+            self.twofa_encryption_key.get_secret_value()
+            if self.twofa_encryption_key
+            else ""
+        )
+        return [k.strip() for k in raw.split(",") if k.strip()]
+
+    @model_validator(mode="after")
+    def _twofa_key_in_prod(self, info: ValidationInfo) -> IdentitySettings:
+        ctx: dict[str, Any] = info.context or {}
+        if ctx.get("environment") != "prod":
+            return self
+        keys = self.keys()
+        if not keys:
+            raise ValueError(
+                "TWOFA_ENCRYPTION_KEY is required with ENVIRONMENT=prod (no "
+                "JWT_SECRET fallback in production); generate one with openssl "
+                "rand -hex 32"
+            )
+        for idx, key in enumerate(keys):
+            problem = secret_problem(key)
+            if problem:
+                raise ValueError(
+                    f"TWOFA_ENCRYPTION_KEY[{idx}] is {problem}; generate a random "
+                    "one (e.g. openssl rand -hex 32)"
+                )
+        return self
+
+
+def identity_settings() -> IdentitySettings:
+    return settings_of(IdentitySettings)
