+def module_config(redact: bool = True) -> tuple[list[ConfigEntry], list[str]]:
+    """KB-49 PoC (ADR-0015 decision 8): build the composition in collect mode
+    and list every loaded module's declared values with provenance.
+
+    No lifespan is entered and nothing is started: the composition root is
+    imported (registration + setup only). Settings errors and load failures
+    are returned as diagnosed problems instead of exiting."""
+    from sandloom.core.composition import load_composition_core
+    from sandloom.core.config import module_settings as ms
+
+    problems: list[str]
+    core = None
+    with ms.collect_mode() as problems:
+        try:
+            core = load_composition_core()
+        except BaseException as exc:  # noqa: BLE001 - diagnosed, not fatal
+            text = str(exc) or type(exc).__name__
+            if not any(text in p or p in text for p in problems):
+                problems.append(text)
+    regs = ms.records(core) if core is not None else dict(ms.STATE.records)
+    if not regs:
+        # the root failed before exposing its core: the records stay on the
+        # facade the loader was given; fall back to the last checked state.
+        regs = dict(ms.STATE.records)
+    entries: list[ConfigEntry] = []
+    for module, record in sorted(regs.items()):
+        names = ms.env_names(record.model)
+        for env_name, field_name in sorted(names.items()):
+            secret_field = ms.is_secret_field(record.model, field_name)
+            if record.instance is not None:
+                raw = getattr(record.instance, field_name)
+            else:
+                raw = ms.process_snapshot().get(env_name)[0]
+            secret = secret_field or (
+                is_secret_name(env_name) and not isinstance(raw, (bool, int, float))
+            )
+            value = (
+                redact_value(env_name, raw, secret=secret)
+                if redact
+                else _plain_secret(raw)
+            )
+            if record.instance is None:
+                value = f"{value} (invalid: see problems)"
+            entries.append(
+                ConfigEntry(
+                    name=env_name,
+                    value=value,
+                    source=f"{record.origins.get(env_name) or 'default'} module={module}",
+                    secret=secret,
+                )
+            )
+    return entries, problems
+
+
+def _plain_secret(value: Any) -> Any:
+    secret = getattr(value, "get_secret_value", None)
+    return secret() if callable(secret) else _plain(value)
+
+
 def _render_text(entries: list[ConfigEntry]) -> str:
     width = max((len(e.name) for e in entries), default=0)
     lines = []
