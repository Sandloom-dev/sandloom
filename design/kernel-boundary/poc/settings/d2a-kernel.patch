--- /dev/null
+++ b/src/sandloom/core/cli/settings_gate.py
@@ -0,0 +1,196 @@
+"""KB-49 PoC: the static settings gate (ADR-0015 decisions 6, 7; D-M5).
+
+``sandloom check settings [--modules a,b] [--profile compose.yml] [--env K=V]``
+
+Imports every module of the app (side-effect free), then:
+
+* one env name declared twice across the kernel and ANY two modules, loaded
+  together or not (SANDLOOM-B036);
+* a new name without the module's prefix (``INVENTORY_``) unless the
+  committed ``module.snapshot.json`` already records it (grandfathered);
+* each module's tiers against its snapshot (a semantic setting cannot slip
+  in as ops unreviewed) — the per-module ratchet;
+* for each service of a topology: wrong names in ``SANDLOOM_MODULES``,
+  variables set for a module the service does not load, and literal values
+  (``${VAR:?…}`` placeholders skipped) validated against the declarations.
+"""
+
+from __future__ import annotations
+
+import argparse
+import importlib
+import json
+import sys
+from pathlib import Path
+from typing import Any
+
+from pydantic import ValidationError
+
+from sandloom.core.config import module_settings as ms
+
+CODE = "SANDLOOM-B036"
+
+
+def declaration(module: str) -> tuple[str, Any] | None:
+    path = ms.installed_module_names().get(module, module)
+    package = importlib.import_module(path)
+    model = getattr(getattr(package, "register", None), "__sandloom_settings__", None)
+    if model is None:
+        return None
+    return ms.module_short_name(path), model
+
+
+def _snapshot_settings(module_path: str) -> dict[str, str] | None:
+    package = importlib.import_module(module_path)
+    file = Path(str(package.__file__)).parent / "module.snapshot.json"
+    if not file.is_file():
+        return None
+    data = json.loads(file.read_text())
+    settings = data.get("settings")
+    return dict(settings) if isinstance(settings, dict) else None
+
+
+def static_problems(modules: list[str]) -> list[str]:
+    from sandloom.core.config.settings import Settings
+
+    problems: list[str] = []
+    owners: dict[str, str] = {
+        str(f.alias or n).upper(): "kernel" for n, f in Settings.model_fields.items()
+    }
+    for module in modules:
+        try:
+            found = declaration(module)
+        except Exception as exc:  # noqa: BLE001
+            problems.append(f"{module}: cannot import ({exc})")
+            continue
+        if found is None:
+            continue
+        short, model = found
+        path = ms.installed_module_names().get(module, module)
+        recorded = _snapshot_settings(path) or {}
+        tiers = ms.module_tiers(model)
+        for name in sorted(ms.env_names(model)):
+            if name in owners:
+                problems.append(
+                    f"{CODE}: {name} is declared by {owners[name]} and module {short}"
+                )
+            else:
+                owners[name] = f"module {short}"
+            prefix = f"{short.upper()}_"
+            if not name.startswith(prefix) and name not in recorded:
+                problems.append(
+                    f"{short}: new setting {name} must start with {prefix} "
+                    "(existing unprefixed names are grandfathered by "
+                    "module.snapshot.json)"
+                )
+        if recorded and recorded != tiers:
+            changed = sorted(
+                n for n in set(recorded) | set(tiers) if recorded.get(n) != tiers.get(n)
+            )
+            problems.append(
+                f"{short}: settings tiers differ from module.snapshot.json for "
+                f"{changed}: review, then `sandloom generate`"
+            )
+    return problems
+
+
+def topology_problems(
+    services: dict[str, dict[str, str]], app_modules: list[str]
+) -> list[str]:
+    """Each service's env against the declarations of what it loads."""
+    problems: list[str] = []
+    declared: dict[str, tuple[str, Any]] = {}
+    known = set(app_modules) | set(ms.installed_module_names())
+    for module in app_modules:
+        found = declaration(module)
+        if found:
+            declared[module] = found
+    installed = ms.installed_module_names()
+    known |= set(installed.values())
+    for service, env in sorted(services.items()):
+        raw = env.get("SANDLOOM_MODULES", "[]")
+        try:
+            listed = [str(m) for m in json.loads(raw)]
+        except ValueError:
+            listed = [m.strip() for m in raw.split(",") if m.strip()]
+        loads = []
+        for name in listed:
+            if name not in known:
+                problems.append(
+                    f"{service}: SANDLOOM_MODULES names unknown module {name!r}"
+                )
+            loads.append(ms.module_short_name(name))
+        environment = env.get("ENVIRONMENT", "dev")
+        for _module, (short, model) in sorted(declared.items()):
+            names = set(ms.env_names(model))
+            set_here = sorted(n for n in names if n in env)
+            if short not in loads:
+                if set_here:
+                    problems.append(
+                        f"{service}: sets {set_here} for module {short}, which "
+                        "this service does not load"
+                    )
+                continue
+            data = {n: env[n] for n in set_here if "${" not in env[n]}
+            accepted = env.get("SANDLOOM_ACCEPTED_RISKS", "")
+            ids = (
+                set(json.loads(accepted))
+                if accepted.startswith("[")
+                else {a.strip() for a in accepted.split(",") if a.strip()}
+            )
+
+            def accepts(risk_id: str, _short: str = short) -> bool:
+                return f"{_short}.{risk_id}" in ids or risk_id in ids
+
+            try:
+                model.model_validate(
+                    data, context={"environment": environment, "accepts_risk": accepts}
+                )
+            except ValidationError as exc:
+                problems.append(
+                    f"{service}: module {short}: {ms._format(exc, ms.env_names(model))}"
+                )
+    return problems
+
+
+def _profile_services(path: Path) -> dict[str, dict[str, str]]:
+    from sandloom.core.testing.deploy_profile import _env, app_processes, load_profile
+
+    compose = load_profile(path)
+    return {
+        name: {
+            k: (v if isinstance(v, str) else json.dumps(v))
+            for k, v in _env(svc).items()
+        }
+        for name, svc in app_processes(compose).items()
+    }
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(prog="sandloom check settings")
+    parser.add_argument("--modules", default="", help="every module of the app")
+    parser.add_argument("--profile", default=None, help="compose profile of a topology")
+    parser.add_argument(
+        "--service", action="append", default=[], help="NAME:JSON env of one service"
+    )
+    args = parser.parse_args(argv)
+    modules = [m.strip() for m in args.modules.split(",") if m.strip()] or sorted(
+        ms.installed_module_names()
+    )
+    problems = static_problems(modules)
+    services: dict[str, dict[str, str]] = {}
+    if args.profile:
+        services.update(_profile_services(Path(args.profile)))
+    for item in args.service:
+        name, _, env = item.partition(":")
+        services[name] = json.loads(env)
+    if services:
+        problems += topology_problems(services, modules)
+    for problem in problems:
+        print(f"FAIL {problem}")
+    print(f"settings gate: {len(problems)} problem(s) over {len(modules)} module(s)")
+    return 1 if problems else 0
+
+
+if __name__ == "__main__":  # pragma: no cover
+    sys.exit(main())
