index 0000000..922e11d
--- /dev/null
+++ b/src/sandloom/core/tests/test_claim_trust.py
@@ -0,0 +1,298 @@
+"""kb-poc-trust (TA-1): the trusted view, the policy marker, the sealed mint,
+one platform admission, and the revocation duties (R1, R2)."""
+
+from __future__ import annotations
+
+import time
+import uuid
+from typing import Any
+
+import jwt
+import pytest
+from fastapi import FastAPI, HTTPException
+
+import sandloom.core.auth.claim_trust as ct
+from sandloom.core.app_factory import claim_trust_setup as setup
+from sandloom.core.auth import tokens
+from sandloom.core.config.settings import settings
+from sandloom.core.facade import CoreFacade
+from sandloom.sdk.security import ensure_token_not_revoked
+from sandloom.sdk.testing import InMemoryCache, revocation_mark_key, use_security_cache
+from sandloom.shared.authz import Not, Or, Perm, Requirement, Role
+from sandloom.shared.authz.context import AuthzContext
+from sandloom.shared.guards.platform import require_platform_admin
+from sandloom.shared.subject import UserContext
+
+MAP = {
+    "roles": "sandloom_identity",
+    "permissions": "sandloom_identity",
+    "tenant_ids": "sandloom_tenancy",
+}
+
+
+@pytest.fixture
+def policy() -> Any:
+    previous = ct._active_policy
+    built = ct.ClaimTrustPolicy(authorities=dict(MAP), test_authority=False)
+    ct.activate(built)
+    yield built
+    ct.activate(previous)
+
+
+def _sign(claims: dict[str, Any]) -> str:
+    now = int(time.time())
+    base = {
+        "sub": str(uuid.uuid4()),
+        "token_type": "access",
+        "iat": now,
+        "exp": now + 600,
+    }
+    return jwt.encode(
+        {**base, **claims}, settings.jwt_secret, algorithm=settings.jwt_algorithm
+    )
+
+
+def _subject(token: str) -> UserContext:
+    payload = tokens.decode_token(token)
+    assert payload is not None
+    return UserContext(**payload)
+
+
+class _Allow(Requirement):
+    async def evaluate(self, ctx: Any) -> bool:
+        return True
+
+
+async def _decide(req: Requirement, subject: UserContext) -> Any:
+    return await req.decide(AuthzContext(subject=subject))
+
+
+# ---- M4 / M5a: the view --------------------------------------------------
+LEGACY = {
+    "L1 no failed": {"roles": ["admin"], "claims_sources": ["identity"]},
+    "L2 no provenance": {"roles": ["admin"], "permissions": ["p"]},
+    "L3 failed=[] no cpv": {
+        "roles": ["admin"],
+        "claims_sources": ["identity"],
+        "claims_sources_failed": [],
+    },
+}
+
+
+@pytest.mark.parametrize("shape", sorted(LEGACY))
+async def test_legacy_token_keeps_authentication_and_loses_protected_claims(
+    policy: ct.ClaimTrustPolicy, shape: str
+) -> None:
+    subject = _subject(_sign(LEGACY[shape]))
+    assert subject.roles == set()
+    assert subject.untrusted_claims["roles"] == ct.OUTDATED
+    decision = await _decide(Role("admin"), subject)
+    assert decision.indeterminate and decision.http_status == 401
+    assert decision.code == "token_policy_outdated"
+    assert (await _decide(Or(Role("admin"), _Allow()), subject)).allowed
+    negated = await _decide(Not(Role("admin")), subject)
+    assert not negated.allowed and negated.http_status == 401
+
+
+async def test_current_token_from_the_authority_is_trusted(
+    policy: ct.ClaimTrustPolicy,
+) -> None:
+    token = _sign(
+        {
+            "roles": ["admin"],
+            "claims_sources": ["identity"],
+            "claims_sources_failed": [],
+            "cpv": policy.marker,
+        }
+    )
+    subject = _subject(token)
+    assert subject.roles == {"admin"}
+    assert (await _decide(Role("admin"), subject)).allowed
+    await require_platform_admin(subject=subject)
+
+
+async def test_authority_absent_or_failed_is_a_definite_deny(
+    policy: ct.ClaimTrustPolicy,
+) -> None:
+    for prov in (
+        {"claims_sources": ["billing"], "claims_sources_failed": []},
+        {"claims_sources": [], "claims_sources_failed": ["identity"]},
+    ):
+        subject = _subject(_sign({"roles": ["admin"], "cpv": policy.marker, **prov}))
+        assert subject.untrusted_claims["roles"] == ct.AUTHORITY_ABSENT
+        decision = await _decide(Role("admin"), subject)
+        assert (
+            not decision.allowed
+            and not decision.indeterminate
+            and decision.http_status == 403
+        )
+        with pytest.raises(HTTPException) as refused:
+            await require_platform_admin(subject=subject)
+        assert refused.value.status_code == 403
+
+
+async def test_unassigned_protected_key_is_a_definite_deny() -> None:
+    previous = ct._active_policy
+    ct.activate(ct.ClaimTrustPolicy(authorities={}))
+    try:
+        marker = ct.active_policy().marker
+        subject = _subject(
+            _sign(
+                {
+                    "permissions": ["p"],
+                    "claims_sources": ["x"],
+                    "claims_sources_failed": [],
+                    "cpv": marker,
+                }
+            )
+        )
+        assert subject.untrusted_claims == {"permissions": ct.UNASSIGNED}
+        decision = await _decide(Perm("p"), subject)
+        assert not decision.allowed and decision.http_status == 403
+    finally:
+        ct.activate(previous)
+
+
+async def test_skewed_issuer_map_is_untrusted(policy: ct.ClaimTrustPolicy) -> None:
+    other = ct.policy_marker({**MAP, "roles": "sandloom_billing"})
+    subject = _subject(
+        _sign(
+            {
+                "roles": ["admin"],
+                "claims_sources": ["identity"],
+                "claims_sources_failed": [],
+                "cpv": other,
+            }
+        )
+    )
+    assert subject.untrusted_claims["roles"] == ct.OUTDATED
+
+
+async def test_a_forged_untrusted_marker_in_the_token_is_overwritten(
+    policy: ct.ClaimTrustPolicy,
+) -> None:
+    subject = _subject(
+        _sign({"roles": ["admin"], ct.UNTRUSTED_KEY: {}, "untrusted_claims": {}})
+    )
+    assert subject.untrusted_claims["roles"] == ct.OUTDATED
+
+
+# ---- M5b: the sealed mint ------------------------------------------------
+@pytest.mark.parametrize(
+    "data",
+    [
+        {"roles": ["admin"]},
+        {"claims_sources": ["identity"]},
+        {"cpv": "1:x"},
+        {"tenant_ids": []},
+    ],
+)
+def test_create_access_token_refuses_unsealed_protected_claims(
+    policy: ct.ClaimTrustPolicy, data: dict[str, Any]
+) -> None:
+    with pytest.raises(ct.UnsealedClaimsError):
+        tokens.create_access_token(data={"sub": str(uuid.uuid4()), **data})
+
+
+def test_issuer_email_without_a_sealed_cpv_is_untrusted(
+    policy: ct.ClaimTrustPolicy,
+) -> None:
+    token = tokens.create_access_token(
+        data={"sub": str(uuid.uuid4()), "token_type": "access", "email": "a@b"}
+    )
+    payload = tokens.decode_token(token)
+    assert payload is not None and "email" not in payload
+    assert payload[ct.UNTRUSTED_KEY]["email"] == ct.OUTDATED
+
+
+def test_spreading_a_sealed_result_is_refused(policy: ct.ClaimTrustPolicy) -> None:
+    sealed = ct.seal(
+        {
+            "roles": ["admin"],
+            "claims_sources": ["identity"],
+            "claims_sources_failed": [],
+            "cpv": policy.marker,
+        }
+    )
+    with pytest.raises(ct.UnsealedClaimsError):
+        tokens.create_access_token(data={**sealed, "sub": str(uuid.uuid4())})
+    token = tokens.create_access_token(
+        data={"sub": str(uuid.uuid4()), "token_type": "access"}, claims=sealed
+    )
+    assert _subject(token).roles == {"admin"}
+
+
+@pytest.mark.parametrize(
+    "data", [{"roles": ["admin"]}, {"tenant_id": str(uuid.uuid4())}, {"cpv": "1:x"}]
+)
+def test_service_token_refuses_protected_claims(
+    policy: ct.ClaimTrustPolicy, data: dict[str, Any]
+) -> None:
+    with pytest.raises(ct.UnsealedClaimsError):
+        tokens.create_service_token({"sub": str(uuid.uuid4()), **data})
+
+
+async def test_service_token_grants_nothing_and_is_current(
+    policy: ct.ClaimTrustPolicy,
+) -> None:
+    token = tokens.create_service_token(
+        {"sub": str(uuid.uuid4()), "token_type": "access"}
+    )
+    subject = _subject(token)
+    assert subject.untrusted_claims == {}
+    decision = await _decide(Role("admin"), subject)
+    assert not decision.allowed and decision.http_status == 403
+
+
+def test_test_authority_is_refused_outside_a_test_composition() -> None:
+    was = ct.test_authority_enabled()
+    ct.enable_test_authority(False)
+    try:
+        with pytest.raises(ct.UnsealedClaimsError):
+            ct.seal_test_claims({"roles": ["admin"]})
+    finally:
+        ct.enable_test_authority(was)
+
+
+def test_test_authority_refused_in_a_production_composition() -> None:
+    p = ct.ClaimTrustPolicy(
+        authorities={"roles": ct.TEST_AUTHORITY}, test_authority=True
+    )
+    problems = ct.authority_problems(
+        p,
+        loaded={},
+        contributors={},
+        bindings={},
+        issues_tokens=False,
+        strict_profile=True,
+    )
+    assert any("production composition" in x for x in problems)
+    assert any("test authority" in x for x in problems)
+
+
+# ---- R1 / R2 --------------------------------------------------------------
+async def test_kernel_registers_and_runs_the_revocation_applier(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    core = CoreFacade(app=FastAPI())
+    setup.register_kernel_revocation_applier(core)
+    (consumer,) = [
+        c for c in core.event_consumers if c.channel == setup.TOKENS_REVOKED_CHANNEL
+    ]
+    assert consumer.module == "sandloom" and consumer.dead_letter is False
+    cache = InMemoryCache()
+    use_security_cache(monkeypatch, cache)
+    sub, mark = str(uuid.uuid4()), time.time() + 2.0
+    envelope = {
+        "id": str(uuid.uuid4()),
+        "payload": {"user_id": sub, "valid_after": mark, "reason": "t"},
+    }
+    cache.broken = True
+    with pytest.raises(RuntimeError):
+        await consumer.handler(None, envelope)  # redelivered while the cache is out
+    cache.broken = False
+    await consumer.handler(None, envelope)
+    assert revocation_mark_key(sub) in cache.store
+    with pytest.raises(HTTPException) as revoked:
+        await ensure_token_not_revoked(None, {"sub": sub, "iat": int(mark) - 5})
+    assert revoked.value.status_code == 401
