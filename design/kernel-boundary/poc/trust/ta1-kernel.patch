@@ -0,0 +1,551 @@
+"""Claim trust (kb-poc-trust, TA-1): who may issue a protected claim, and
+the trusted view every verifier reads.
+
+PoC of alternatives-c-authz.md §2.2 (TA-1, M1-M5):
+
+* **M1** the application assigns each protected claim key to the module that
+  is its authority (``create_app(claim_authorities={key: module path})``, the
+  composition root). :func:`build_policy` resolves the map;
+  :func:`authority_problems` are the startup refusals (SANDLOOM-B035).
+* **M2** the merge (``core.facade._claims``) accepts a protected key only from
+  its authority's step; :func:`protected_key_owner` answers who that is.
+* **M4** :meth:`ClaimTrustPolicy.view` is applied once per verified token
+  (:func:`sandloom.core.auth.tokens.decode_token`, cached with the token): a
+  protected key is kept only when its assigned authority is in
+  ``claims_sources``, not in ``claims_sources_failed``, and the token's
+  ``cpv`` equals this process's marker. Every untrusted key is removed and
+  listed under :data:`UNTRUSTED_KEY` with the reason.
+* **M5a** ``cpv``: the policy version and a digest of the map, stamped by the
+  merge; a token without it, or with another, keeps authentication and its
+  unprotected claims and loses its protected ones (reason
+  :data:`OUTDATED`).
+* **M5b** :class:`SealedClaims`: the only carrier of protected keys,
+  provenance and ``cpv`` that ``create_access_token`` accepts; built by
+  ``collect_claims`` and, in a test composition only, by
+  :func:`seal_test_claims` (the kernel test authority).
+
+The kernel names no module: the map comes from the composition root.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import json
+import logging
+from collections import Counter
+from collections.abc import Iterable, Iterator, Mapping
+from dataclasses import dataclass, field
+from typing import Any
+
+from sandloom.core.descriptors.module_names import (
+    installed_modules,
+    module_name,
+    resolve_module_names,
+)
+
+logger = logging.getLogger("sandloom.claims.trust")
+
+#: Version of the provenance policy format (part of ``cpv``).
+POLICY_VERSION = "1"
+#: The claim the merge stamps: ``"<version>:<digest of the map>"``.
+POLICY_CLAIM = "cpv"
+#: Key the trusted view writes into a verified payload: ``{key: reason}`` of
+#: every protected key it removed (always overwritten: never from the token).
+UNTRUSTED_KEY = "sandloom.untrusted"
+
+#: Reasons a protected key is not trusted.
+OUTDATED = "token_policy_outdated"  # no / another ``cpv``: refresh fixes it
+UNASSIGNED = "unassigned"  # no authority assigned: a definite deny
+AUTHORITY_ABSENT = "authority_absent"  # its authority did not vouch for it
+
+#: Always protected (I-21: kernel concepts).
+ALWAYS_PROTECTED: frozenset[str] = frozenset({"roles", "permissions", "tenant_ids"})
+#: Read by kernel claim atoms today (``Subscribed`` / ``Feature`` /
+#: ``WithinLimit``); protected whether or not the app assigns them (answer
+#: #10: an access-granting billing claim needs an assigned authority).
+ATOM_KEYS: frozenset[str] = frozenset(
+    {"subscription_status", "plan_code", "features", "limits"}
+)
+#: The tenant the request binds (TenantScope reads them before the grant):
+#: trusted with the authority of ``tenant_ids``.
+TENANT_SELECTORS: frozenset[str] = frozenset({"tenant_id", "org_id"})
+#: Stamped by the issuer, never by a contributor (answer #10): trusted iff the
+#: token carries this process's ``cpv``.
+ISSUER_KEYS: frozenset[str] = frozenset({"email", "email_verified"})
+#: Provenance and marker: only the merge (or the test authority) writes them.
+PROVENANCE_KEYS: frozenset[str] = frozenset(
+    {"claims_sources", "claims_sources_failed", POLICY_CLAIM}
+)
+
+#: The kernel test authority's provenance name and marker. Not a valid module
+#: short name (a hyphen), so no module can register under it.
+TEST_AUTHORITY = "sandloom-test"
+TEST_MARKER = "test"
+
+#: Contributions dropped by the violator rule, by contributor (answer #12).
+VIOLATIONS: Counter[str] = Counter()
+
+
+class ClaimTrustError(RuntimeError):
+    """SANDLOOM-B035: the claim-authority assignment cannot be honoured."""
+
+    sandloom_code = "SANDLOOM-B035"
+
+
+class UnsealedClaimsError(ValueError):
+    """SANDLOOM-R017: protected claims, provenance or ``cpv`` handed to a
+    token mint outside a sealed ``collect_claims`` result."""
+
+    sandloom_code = "SANDLOOM-R017"
+
+
+def _short(path: str) -> str:
+    """The provenance name a module is stamped under (its short name)."""
+    if path == TEST_AUTHORITY:
+        return path
+    return module_name(path)
+
+
+def policy_marker(authorities: Mapping[str, str]) -> str:
+    digest = hashlib.sha256(
+        json.dumps(sorted(authorities.items()), separators=(",", ":")).encode()
+    ).hexdigest()[:12]
+    return f"{POLICY_VERSION}:{digest}"
+
+
+@dataclass(frozen=True)
+class ClaimTrustPolicy:
+    """The resolved assignment of one composition (one per process)."""
+
+    #: claim key -> module import path (or :data:`TEST_AUTHORITY`).
+    authorities: Mapping[str, str] = field(default_factory=dict)
+    #: True only in a test composition (the pytest plugin): tokens stamped
+    #: :data:`TEST_MARKER` by :func:`seal_test_claims` are trusted.
+    test_authority: bool = False
+    #: PoC switch: ``"ta1"`` (M1-M5) or ``"ta0"`` (the control: M1, M2 and
+    #: one platform admission on raw claims; no view, no cpv, no sealed mint).
+    mode: str = "ta1"
+    #: claim key -> the provenance name its authority is stamped under.
+    owners: Mapping[str, str] = field(init=False)
+    protected: frozenset[str] = field(init=False)
+    marker: str = field(init=False)
+
+    def __post_init__(self) -> None:
+        owners = {k: _short(v) for k, v in self.authorities.items()}
+        tenant_owner = owners.get("tenant_ids")
+        if tenant_owner is not None:
+            for key in TENANT_SELECTORS:
+                owners.setdefault(key, tenant_owner)
+        object.__setattr__(self, "owners", owners)
+        object.__setattr__(
+            self,
+            "protected",
+            frozenset(ALWAYS_PROTECTED | ATOM_KEYS | TENANT_SELECTORS)
+            | frozenset(self.authorities),
+        )
+        object.__setattr__(self, "marker", policy_marker(self.authorities))
+
+    # ---- verifier side (M4, M5a) -------------------------------------
+    def view(self, payload: dict[str, Any]) -> dict[str, Any]:  # noqa: C901 - one pass over the protected keys
+        """``payload`` with every untrusted protected key removed (in place).
+
+        Writes :data:`UNTRUSTED_KEY` ``{key: reason}`` (empty when every
+        protected key present is trusted). For a token under another policy
+        (no or another ``cpv``) every assigned protected key is listed as
+        :data:`OUTDATED`, present or not, so an atom that needs one answers
+        401 ``token_policy_outdated`` instead of a definite deny.
+        """
+        untrusted: dict[str, str] = {}
+        if self.mode == "ta0":
+            payload.pop(UNTRUSTED_KEY, None)
+            return payload
+        marker = payload.get(POLICY_CLAIM)
+        sources = payload.get("claims_sources")
+        failed = payload.get("claims_sources_failed")
+        src = set(sources) if isinstance(sources, list) else set()
+        bad = set(failed) if isinstance(failed, list) else set()
+        if (
+            self.test_authority
+            and marker == TEST_MARKER
+            and TEST_AUTHORITY in src
+            and TEST_AUTHORITY not in bad
+        ):
+            payload.pop(UNTRUSTED_KEY, None)
+            return payload
+        # A test token (seal_test_claims) stating its own provenance is read
+        # as current: the view then checks each key against that provenance.
+        current = marker == self.marker or (
+            self.test_authority and marker == TEST_MARKER
+        )
+        if not current:
+            _note_foreign_marker(marker, self.marker)
+        owners = self.owners
+        for key in self.protected:
+            owner = owners.get(key)
+            present = key in payload
+            if owner is None:
+                if present:
+                    untrusted[key] = UNASSIGNED
+                    del payload[key]
+                continue
+            if not current:
+                untrusted[key] = OUTDATED
+                if present:
+                    del payload[key]
+                continue
+            if present and (owner not in src or owner in bad):
+                untrusted[key] = AUTHORITY_ABSENT
+                del payload[key]
+        if not current:
+            for key in ISSUER_KEYS:
+                if key in payload:
+                    untrusted[key] = OUTDATED
+                    del payload[key]
+        # Only a non-empty verdict is written (a forged one is always dropped):
+        # the common, fully trusted token carries no extra key per request.
+        if untrusted:
+            payload[UNTRUSTED_KEY] = untrusted
+        else:
+            payload.pop(UNTRUSTED_KEY, None)
+        return payload
+
+    # ---- mint side (M2) ----------------------------------------------
+    def owner_of(self, key: str) -> str | None:
+        """Provenance name of ``key``'s authority (``None``: unassigned)."""
+        return self.owners.get(key)
+
+
+#: Foreign ``cpv`` values already logged (once each: skew detection).
+_SEEN_MARKERS: set[str] = set()
+
+
+def _note_foreign_marker(marker: Any, mine: str) -> None:
+    label = marker if isinstance(marker, str) else "<none: legacy token>"
+    if label in _SEEN_MARKERS or len(_SEEN_MARKERS) > 64:
+        return
+    _SEEN_MARKERS.add(label)
+    logger.warning(
+        "claim policy mismatch: a token minted under cpv=%s reached a process "
+        "running cpv=%s; its protected claims are untrusted (legacy token, or "
+        "issuer and verifier run different claim_authorities)",
+        label,
+        mine,
+    )
+
+
+#: The active composition's policy (answer #8: one per production process);
+#: create_app binds it (core.testing.isolation snapshots it).
+_active_policy: ClaimTrustPolicy | None = None
+#: Set by the pytest plugin before any app is built.
+_TEST_COMPOSITION: list[bool] = [False]
+#: The empty policy every verifier uses before a composition is active.
+_EMPTY = ClaimTrustPolicy()
+
+
+def active_policy() -> ClaimTrustPolicy:
+    """The policy of the active composition (fail closed: none assigned)."""
+    policy = _active_policy
+    return policy if policy is not None else _EMPTY
+
+
+def activate(policy: ClaimTrustPolicy | None) -> None:
+    global _active_policy
+    _active_policy = policy
+
+
+def enable_test_authority(on: bool = True) -> None:
+    """Mark this process as a test composition (the pytest plugin)."""
+    _TEST_COMPOSITION[0] = on
+
+
+def test_authority_enabled() -> bool:
+    return _TEST_COMPOSITION[0]
+
+
+def build_policy(
+    authorities: Mapping[str, str] | None, mode: str = "ta1"
+) -> ClaimTrustPolicy:
+    """The policy of a composition root's ``claim_authorities``: entry-point
+    names (``"identity"``) normalised to import paths, as SANDLOOM_MODULES."""
+    resolved: dict[str, str] = {}
+    for key, path in (authorities or {}).items():
+        if not isinstance(key, str) or not isinstance(path, str) or not path:
+            raise ClaimTrustError(
+                f"SANDLOOM-B035: claim_authorities[{key!r}] = {path!r}: a claim "
+                "key maps to a module import path or entry-point name"
+            )
+        resolved[key] = (
+            path if path == TEST_AUTHORITY else resolve_module_names([path])[0]
+        )
+    if mode not in ("ta1", "ta0"):
+        raise ClaimTrustError(f"SANDLOOM-B035: unknown claim trust mode {mode!r}")
+    return ClaimTrustPolicy(
+        authorities=resolved, test_authority=_TEST_COMPOSITION[0], mode=mode
+    )
+
+
+def resolvable(path: str) -> bool:
+    """True when ``path`` names an importable module or an entry point."""
+    if path == TEST_AUTHORITY:
+        return True
+    try:
+        if importlib.util.find_spec(path) is not None:
+            return True
+    except (ImportError, ValueError):
+        pass
+    return any(m.name == path for m in installed_modules())
+
+
+def authority_problems(  # noqa: C901 - one refusal per case (e-2, e-3, e-4)
+    policy: ClaimTrustPolicy,
+    *,
+    loaded: Mapping[str, str],
+    contributors: Mapping[str, bool],
+    bindings: Mapping[str, Mapping[str, Any]],
+    issues_tokens: bool,
+    strict_profile: bool,
+) -> list[str]:
+    """Startup refusals of the assignment (e-2, e-3, e-4, test authority).
+
+    ``loaded``: short name -> import path of every module loaded here;
+    ``contributors``: short name -> critical, of every local claims owner;
+    ``bindings``: ``SERVICE_BINDINGS``; ``issues_tokens``: a module of this
+    process mints tokens (only such a process needs the authorities).
+    """
+    problems: list[str] = []
+    if policy.test_authority and strict_profile:
+        problems.append(
+            "the kernel test authority is enabled in a production composition "
+            "(the sandloom.sdk.testing plugin is loaded in a prod process)"
+        )
+    for key, path in sorted(policy.authorities.items()):
+        if path == TEST_AUTHORITY:
+            if not policy.test_authority or strict_profile:
+                problems.append(
+                    f"claim {key!r} is assigned to the kernel test authority "
+                    f"{TEST_AUTHORITY!r}, which only a test composition may assign"
+                )
+            continue
+        if not resolvable(path):
+            problems.append(
+                f"claim {key!r} is assigned to {path!r}, which names no module "
+                "(not importable, no sandloom.modules entry point): a typo?"
+            )
+            continue
+        if not issues_tokens:
+            continue
+        short = _short(path)
+        binding = bindings.get(f"{short}.claims.v1")
+        if loaded.get(short) == path or (short in loaded and path == short):
+            critical = contributors.get(short)
+            if critical is None:
+                problems.append(
+                    f"claim {key!r} is assigned to {path!r}, which is loaded in "
+                    "this issuing process but registers no claims contributor"
+                )
+            elif not critical:
+                problems.append(
+                    f"claim {key!r} is assigned to {path!r}, whose claims "
+                    "contributor is registered critical=False: the authority of "
+                    "a protected claim must be critical (answer #14)"
+                )
+        elif short in loaded:
+            problems.append(
+                f"claim {key!r} is assigned to {path!r}, but the module loaded "
+                f"here under the short name {short!r} is {loaded[short]!r}"
+            )
+        elif binding is None:
+            problems.append(
+                f"claim {key!r} is assigned to {path!r}, which is neither loaded "
+                f"in this issuing process nor bound ({short}.claims.v1 is not "
+                "in SERVICE_BINDINGS)"
+            )
+        elif binding.get("critical", True) is False:
+            problems.append(
+                f"claim {key!r} is assigned to {path!r}, whose binding "
+                f"{short}.claims.v1 is critical: false: the authority of a "
+                "protected claim must be critical (answer #14)"
+            )
+    return problems
+
+
+def unassigned_writers_warning(
+    policy: ClaimTrustPolicy, issues_tokens: bool
+) -> str | None:
+    if not issues_tokens:
+        return None
+    missing = sorted(ALWAYS_PROTECTED - set(policy.authorities))
+    if not missing:
+        return None
+    return (
+        "protected claims without an assigned authority: "
+        + ", ".join(missing)
+        + "; every gate reading them denies (pass create_app(claim_authorities=...))"
+    )
+
+
+# ---- M5b: the sealed mint ----------------------------------------------
+_SEAL = object()
+
+
+class SealedClaims(Mapping[str, Any]):
+    """A verified ``collect_claims`` result: the only carrier of protected
+    keys, provenance and ``cpv`` that ``create_access_token`` accepts.
+
+    Read-only; spreading it (``{**sealed}``) yields a plain dict, which the
+    mint refuses. Built by the kernel only (``collect_claims``,
+    :func:`seal_test_claims`).
+    """
+
+    __slots__ = ("_data", "_seal")
+
+    def __init__(self, data: Mapping[str, Any], *, _seal: object = None) -> None:
+        if _seal is not _SEAL:
+            raise UnsealedClaimsError(
+                "SANDLOOM-R017: SealedClaims are built by collect_claims only"
+            )
+        self._data = dict(data)
+        self._seal = _seal
+
+    def __getitem__(self, key: str) -> Any:
+        return self._data[key]
+
+    def __iter__(self) -> Iterator[str]:
+        return iter(self._data)
+
+    def __len__(self) -> int:
+        return len(self._data)
+
+    def __repr__(self) -> str:
+        return f"SealedClaims({self._data!r})"
+
+    def is_sealed(self) -> bool:
+        return self._seal is _SEAL
+
+
+def seal(data: Mapping[str, Any]) -> SealedClaims:
+    """Kernel-internal: seal a merge result (``collect_claims``)."""
+    return SealedClaims(data, _seal=_SEAL)
+
+
+def seal_test_claims(claims: Mapping[str, Any]) -> SealedClaims:
+    """The kernel test authority's contribution (``as_user``), test only.
+
+    Refused unless this process is a test composition (the pytest plugin).
+    """
+    if not _TEST_COMPOSITION[0]:
+        raise UnsealedClaimsError(
+            "SANDLOOM-R017: the kernel test authority mints only in a test "
+            "composition (the sandloom.sdk.testing pytest plugin)"
+        )
+    data = {k: v for k, v in claims.items() if k not in PROVENANCE_KEYS}
+    # Without stated provenance the test authority vouches for every key; a
+    # test that states claims_sources gets exactly that provenance checked
+    # against the composition's assignment (e.g. roles without identity).
+    if "claims_sources" in claims:
