+++ b/src/sandloom/core/app_factory/claim_trust_setup.py
@@ -0,0 +1,158 @@
+"""kb-poc-trust: install the composition's claim-trust policy (M1) and the
+revocation duties (R1 kernel applier, R2 issuer obligation) at create_app.
+
+Refusals raise :class:`~sandloom.core.config.common.ConfigurationError`
+naming the key and the module (SANDLOOM-B035 / SANDLOOM-B036).
+"""
+
+from __future__ import annotations
+
+import logging
+from collections.abc import Mapping
+from typing import Any
+
+import sandloom.core.auth.claim_trust as _claim_trust
+import sandloom.core.consumers.callbacks as _callbacks
+import sandloom.core.consumers.runtime as _runtime
+from sandloom.core.app_factory.config import ConfigurationError
+from sandloom.core.auth.revocation import apply_pending_revocation
+from sandloom.core.config.common import INVALID_CONFIGURATION
+from sandloom.core.config.settings import settings
+from sandloom.core.descriptors import ModuleLoadSummary
+from sandloom.core.descriptors.module_names import module_name
+from sandloom.core.eventing.transport_base import service_name as _service_name
+
+#: R1: the kernel owns core.auth.tokens_revoked.v1 and its durable applier.
+TOKENS_REVOKED_CHANNEL = "core.auth.tokens_revoked.v1"
+#: R2: an issuer ends refresh sessions on this channel.
+USER_BLOCKED_CHANNEL = "core.auth.user_blocked.v1"
+
+
+async def _apply_token_revocation(session: Any, envelope: Mapping[str, Any]) -> None:
+    """The kernel's durable revocation applier (R1, moved from identity)."""
+    await apply_pending_revocation(envelope.get("payload") or {})
+
+
+def register_kernel_revocation_applier(core_facade: Any) -> None:
+    """R1: a kernel-registered durable consumer, like any ``@on``.
+
+    Every process runs the kernel, so the group is per deployment
+    (``sandloom:auth@tokens_revoked@<service or database identity>``): one
+    fixed group shared by
+    the services of a split is refused by the consumer runtime (one group,
+    two databases' exactly-once inboxes). Each service then applies every
+    revocation; marks are monotonic, so a repeated apply is a no-op.
+    """
+    # The service name, else the physical database the exactly-once inbox
+    # lives in (two unnamed services on two databases are two deployments).
+    deployment = _service_name() or _runtime.database_identity(core_facade, "default")
+    group = f"sandloom:auth@tokens_revoked@{deployment}"
+    core_facade.register_event_consumer(
+        _callbacks.EventConsumerDescriptor(
+            name="auth@tokens_revoked",
+            channel=TOKENS_REVOKED_CHANNEL,
+            handler=_apply_token_revocation,
+            module="sandloom",
+            group=group,
+            dead_letter=False,
+        )
+    )
+
+
+def issuer_obligation_problems(
+    core_facade: Any, summary: ModuleLoadSummary
+) -> list[str]:
+    """R2: every module with ``issues_tokens=True`` registered a durable
+    consumer of ``core.auth.user_blocked.v1`` (it owns the refresh sessions)."""
+    problems: list[str] = []
+    consumers = [
+        c
+        for c in core_facade.event_consumers
+        if getattr(c, "channel", None) == USER_BLOCKED_CHANNEL
+        and getattr(c, "durable", True)
+    ]
+    for descriptor in summary.loaded:
+        if not getattr(descriptor, "issues_tokens", False):
+            continue
+        path = str(descriptor.name)
+        names = {path, module_name(path)}
+        if not any(getattr(c, "module", None) in names for c in consumers):
+            problems.append(
+                f"module {path!r} issues tokens but registers no durable consumer "
+                f"of {USER_BLOCKED_CHANNEL}: the issuer ends its refresh sessions "
+                "on an emergency block (answer #16)"
+            )
+    return problems
+
+
+def install_claim_trust(
+    core_facade: Any,
+    summary: ModuleLoadSummary,
+    *,
+    claim_authorities: Mapping[str, str] | None,
+    default_claim_authorities: Mapping[str, str] | None,
+    log: logging.Logger,
+    mode: str = "ta1",
+) -> _claim_trust.ClaimTrustPolicy:
+    """Resolve, check and activate the policy; refuse the boot on a problem.
+
+    ``claim_authorities`` (the app's composition root) is strict. The
+    framework root's ``default_claim_authorities`` keep only the entries whose
+    module is installed (like ``default_modules``), and an absent authority
+    is a warning there, not a refusal.
+    """
+    explicit = claim_authorities is not None
+    raw = dict(claim_authorities or {})
+    if not explicit and default_claim_authorities:
+        raw = {
+            k: v
+            for k, v in default_claim_authorities.items()
+            if _claim_trust.resolvable(v)
+        }
+    try:
+        policy = _claim_trust.build_policy(raw, mode)
+    except Exception as exc:
+        raise ConfigurationError(
+            f"{INVALID_CONFIGURATION}SANDLOOM-B035: {exc}"
+        ) from exc
+    loaded = {module_name(str(d.name)): str(d.name) for d in summary.loaded}
+    contributors: dict[str, bool] = {}
+    for _fn, critical, owner in getattr(core_facade, "_claims_contributors", []):
+        if owner:
+            contributors[owner] = contributors.get(owner, False) or bool(critical)
+    issues_tokens = any(getattr(d, "issues_tokens", False) for d in summary.loaded)
+    strict = bool(settings.is_prod)
+    problems = _claim_trust.authority_problems(
+        policy,
+        loaded=loaded,
+        contributors=contributors,
+        bindings=settings.service_bindings,
+        issues_tokens=issues_tokens,
+        strict_profile=strict,
+    )
+    if not explicit:
+        soft = [p for p in problems if "neither loaded" in p]
+        for p in soft:
+            log.warning("claim trust (default map): %s; its keys are untrusted", p)
+        problems = [p for p in problems if p not in soft]
+    problems += issuer_obligation_problems(core_facade, summary)
+    if problems:
+        for p in problems:
+            log.error("claim trust: %s", p)
+        raise ConfigurationError(
+            INVALID_CONFIGURATION
+            + "SANDLOOM-B035: "
+            + "; ".join(problems)
+            + " (`sandloom explain SANDLOOM-B035`)"
+        )
+    warning = _claim_trust.unassigned_writers_warning(policy, issues_tokens)
+    if warning is not None:
+        log.warning("claim trust: %s", warning)
+    _claim_trust.activate(policy)
+    log.info(
+        "claim trust: cpv=%s authorities=%s test_authority=%s",
+        policy.marker,
+        dict(policy.authorities),
+        policy.test_authority,
+    )
+    return policy
