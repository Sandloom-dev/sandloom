         "Content-Type": "application/json",
     }
 
 
+def sealed_claims(data: dict[str, Any]) -> Any:
+    """kb-poc-trust M5b: a sealed claims result vouched for by the kernel test
+    authority (for a test that fakes ``collect_claims``); test compositions
+    only. A ``claims_sources`` in ``data`` is the provenance checked."""
+    from sandloom.core.auth.claim_trust import seal_test_claims  # noqa: PLC0415 - cold: settings snapshot - the pytest plugin imports this module before .env.test is loaded
+
+    return seal_test_claims(data)
+
+
+def mint_test_token(
+    data: dict[str, Any] | None = None, expires_delta: int | None = None, **kw: Any
+) -> str:
+    """kb-poc-trust M5b: a test token from ``data`` — its protected claims and
+    provenance through the kernel test authority (sealed), the rest as the
+    token's system fields. The test-kit replacement of hand-assembling
+    ``create_access_token(data={...roles...})``."""
+    from sandloom.core.auth.claim_trust import (  # noqa: PLC0415 - cold: settings snapshot - the pytest plugin imports this module before .env.test is loaded
+        ISSUER_KEYS,
+        PROVENANCE_KEYS,
+        TENANT_SELECTORS,
+        guarded_keys,
+        seal_test_claims,
+    )
+    from sandloom.core.auth.tokens import create_access_token  # noqa: PLC0415 - cold: settings snapshot - the pytest plugin imports this module before .env.test is loaded
+
+    data = dict(data or {})
+    sealed_keys = guarded_keys() | TENANT_SELECTORS | ISSUER_KEYS | PROVENANCE_KEYS
+    protected = {k: v for k, v in data.items() if k in sealed_keys}
+    rest = {k: v for k, v in data.items() if k not in sealed_keys}
+    if not protected:
+        return create_access_token(data=rest, expires_delta=expires_delta, **kw)
+    return create_access_token(
+        data=rest, expires_delta=expires_delta, claims=seal_test_claims(protected), **kw
+    )
+
+
