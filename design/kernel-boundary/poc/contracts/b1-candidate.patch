@@ -0,0 +1,575 @@
+"""PoC (kb-poc-contracts, alternative B1): consumer copies owned by the
+consuming distribution.
+
+A module that ships as its own distribution (the framework's top-level
+modules, an ecosystem module) holds the contract stubs, DTO copies and
+expectations it consumes in a reserved subpackage of its own package::
+
+    <module>/_generated/contracts/<x_y_vN>.py            the stub
+    <module>/_generated/contracts/<x_y_vN>.describe.json  the expectation
+    <module>/_generated/contracts/<provider>_dto.py       the DTO copies
+
+The set is read statically from the module's own imports of
+``<module>._generated.contracts.<stem>`` (a ``<provider>_dto`` import pulls
+the contracts of that provider the module declares it consumes). The
+provider is found composed, else imported WITHOUT composing it (its
+``contracts`` submodule, located by the contract's first segment). With no
+provider: a committed copy is kept when its digest verifies, otherwise
+``generate`` refuses naming the module, the contract and the provider.
+"""
+
+from __future__ import annotations
+
+import ast
+import hashlib
+import importlib
+import importlib.util
+import json
+from collections.abc import Callable, Iterable
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+import sandloom.core.cli.dto_copies as _dto_copies
+import sandloom.core.contract_compat as _contract_compat
+from sandloom.core.descriptors.module_names import installed_modules, module_name
+from sandloom.core.module_api import contract_schema
+
+#: Bumped only when the rendered output changes (provenance header).
+GENERATOR_FORMAT = 2
+GENERATED = "_generated"
+EXPECTATION_SUFFIX = ".describe.json"
+#: Refusal code of a consumed contract that cannot be generated or verified.
+CODE_ABSENT = "SANDLOOM-T007"
+_CONTRACT_ATTR = "__sandloom_contract__"
+
+
+# --------------------------------------------------------------------------- #
+# Provenance header
+# --------------------------------------------------------------------------- #
+
+
+def _digest(body: str) -> str:
+    return hashlib.sha256(body.encode("utf-8")).hexdigest()[:16]
+
+
+def with_header(body: str, lines: Iterable[str]) -> str:
+    """``body`` (a rendered file) under the provenance header; the digest
+    covers everything below the header, so an edit is detectable without
+    the provider."""
+    head = [
+        "# Generated by `sandloom generate`: never edit by hand.",
+        *(f"# {line}" for line in lines),
+        f"# generator: format {GENERATOR_FORMAT}  digest: {_digest(body)}",
+    ]
+    return "\n".join(head) + "\n" + body
+
+
+def strip_header(text: str) -> tuple[dict[str, str], str]:
+    """``({key: value}, body)`` of a file written by :func:`with_header`."""
+    lines = text.splitlines(keepends=True)
+    meta: dict[str, str] = {}
+    index = 0
+    while index < len(lines) and lines[index].startswith("# "):
+        line = lines[index][2:].strip()
+        for part in line.split("  "):
+            key, sep, value = part.partition(": ")
+            if sep:
+                meta[key.strip()] = value.strip()
+        index += 1
+    return meta, "".join(lines[index:])
+
+
+def verify(text: str) -> str | None:
+    """A problem when ``text``'s body does not match its header digest."""
+    meta, body = strip_header(text)
+    digest = meta.get("digest")
+    if digest is None:
+        return "no provenance header (digest missing)"
+    if digest != _digest(body):
+        return (
+            f"hand-edited: digest {digest} in the header, {_digest(body)} of the body"
+        )
+    return None
+
+
+def explain_diff(old: str | None, new: str) -> str:
+    """Why a provenance-headed file differs: a generator change (same
+    contract fingerprint, other generator format) or a contract change."""
+    if old is None:
+        return ""
+    if old.lstrip().startswith("{") and new.lstrip().startswith("{"):
+        try:
+            a, b = json.loads(old), json.loads(new)
+        except ValueError:
+            return ""
+        if a.get("fingerprint") and a.get("fingerprint") == b.get("fingerprint"):
+            return (
+                f": generator change (format {a.get('generator_format')} -> "
+                f"{b.get('generator_format')}), fingerprint {a['fingerprint']} unchanged"
+            )
+        return ""
+    before, _ = strip_header(old)
+    after, _ = strip_header(new)
+    if "format" not in before.get("generator", "") and "generator" not in before:
+        return ""
+    fp_old = before.get("fingerprint") or before.get("contracts")
+    fp_new = after.get("fingerprint") or after.get("contracts")
+    gen_old = before.get("generator", "?").split()[-1]
+    gen_new = after.get("generator", "?").split()[-1]
+    if fp_old == fp_new and gen_old != gen_new:
+        return (
+            f": generator change (format {gen_old} -> {gen_new}), contract "
+            f"fingerprint unchanged ({fp_old})"
+        )
+    if fp_old != fp_new:
+        return f": contract change (fingerprint {fp_old} -> {fp_new})"
+    return ": same fingerprint and generator format: edited by hand?"
+
+
+# --------------------------------------------------------------------------- #
+# What a module consumes (static)
+# --------------------------------------------------------------------------- #
+
+
+def imported_stems(package: str, directory: Path) -> set[str]:
+    """Stems of ``<package>._generated.contracts.<stem>`` imported by the
+    module's own source (absolute or relative), its ``_generated`` excluded."""
+    prefix = f"{package}.{GENERATED}.contracts"
+    stems: set[str] = set()
+    for path in sorted(directory.rglob("*.py")):
+        if GENERATED in path.relative_to(directory).parts:
+            continue
+        try:
+            tree = ast.parse(path.read_text(encoding="utf-8"))
+        except (SyntaxError, UnicodeError):
+            continue
+        for node in ast.walk(tree):
+            names: list[str] = []
+            if isinstance(node, ast.ImportFrom):
+                base = node.module or ""
+                if node.level:
+                    rel = path.parent.relative_to(directory).parts
+                    parts = [package, *rel][: len(rel) + 2 - node.level]
+                    base = ".".join([*parts, base] if base else parts)
+                if base == prefix:
+                    names = [a.name for a in node.names]
+                elif base.startswith(prefix + "."):
+                    names = [base[len(prefix) + 1 :].split(".")[0]]
+            elif isinstance(node, ast.Import):
+                for alias in node.names:
+                    if alias.name.startswith(prefix + "."):
+                        names.append(alias.name[len(prefix) + 1 :].split(".")[0])
+            stems.update(names)
+    return stems
+
+
+# --------------------------------------------------------------------------- #
+# Finding a provider without composing it
+# --------------------------------------------------------------------------- #
+
+
+@dataclass
+class Provider:
+    contract: str
+    impl: type
+    package: str
+    distribution: str
+    composed: bool
+
+
+def _provider_spec_name(value: Any) -> str | None:
+    # ``type(value)`` first: a lazy proxy in the provider's namespace (the
+    # settings object) loads itself on any attribute access, isinstance too.
+    if not issubclass(type(value), type):
+        return None
+    spec = value.__dict__.get(_CONTRACT_ATTR)
+    name = getattr(spec, "name", None)
+    return name if isinstance(name, str) else None
+
+
+def candidate_packages(
+    contract: str, source_root: Path | None
+) -> list[tuple[str, str]]:
+    """``(package, distribution)`` that may provide ``contract``: an installed
+    module named like its first segment, then a top-level package of the
+    source tree whose module name matches."""
+    owner = contract.split(".", 1)[0]
+    found = [(m.path, m.distribution) for m in installed_modules() if m.name == owner]
+    if source_root is not None and source_root.is_dir():
+        for child in sorted(source_root.iterdir()):
+            if (child / "__init__.py").is_file() and module_name(child.name) == owner:
+                if all(p != child.name for p, _ in found):
+                    found.append((child.name, "?"))
+    return found
+
+
+def find_uncomposed(contract: str, source_root: Path | None) -> Provider | None:
+    """The ``@contract`` class of ``contract`` from an importable provider
+    package that is NOT composed: its ``contracts`` submodule is imported
+    (no composition, no ``register``, no settings read by the generator)."""
+    for package, dist in candidate_packages(contract, source_root):
+        target = f"{package}.contracts"
+        try:
+            if importlib.util.find_spec(target) is None:
+                continue
+        except (ImportError, ValueError):
+            continue
+        module = importlib.import_module(target)
+        for value in vars(module).values():
+            if issubclass(type(value), type) and _provider_spec_name(value) == contract:
+                return Provider(contract, value, package, dist, composed=False)
+    return None
+
+
+def find_composed(facade: Any, contract: str) -> Provider | None:
+    impl = facade.service_registry.try_get(contract)
+    impl = getattr(impl, "contract_impl", impl)
+    if impl is None or not hasattr(impl, _CONTRACT_ATTR):
+        return None
+    owner = facade.contract_owner(contract) or impl.__module__.split(".")[0]
+    dist = next((m.distribution for m in installed_modules() if m.path == owner), "?")
+    return Provider(contract, impl, owner, dist, composed=True)
+
+
+# --------------------------------------------------------------------------- #
+# Planning one consuming module
+# --------------------------------------------------------------------------- #
+
+
+@dataclass
+class Planned:
+    """One file to write, compare or keep (same fields as ``Generated``)."""
+
+    path: Path
+    content: str
+    code: str
+    problems: list[str] = field(default_factory=list)
+
+
+def expectation_document(provider: Provider) -> dict[str, Any]:
+    schema = contract_schema(provider.impl)
+    describe = {k: v for k, v in schema.describe().items() if k != "codecs"}
+    return {
+        "format": 1,
+        "contract": provider.contract,
+        "fingerprint": schema.hash,
+        "provider": {
+            "distribution": provider.distribution,
+            "class": f"{provider.impl.__module__}.{provider.impl.__qualname__}",
+        },
+        "generator_format": GENERATOR_FORMAT,
+        "describe": describe,
+    }
+
+
+def provider_contracts(package: str) -> dict[str, type]:
+    """``{contract: @contract class}`` of an importable provider package's
+    ``contracts`` submodule (imported, never composed)."""
+    target = f"{package}.contracts"
+    try:
+        if importlib.util.find_spec(target) is None:
+            return {}
+    except (ImportError, ValueError):
+        return {}
+    module = importlib.import_module(target)
+    out: dict[str, type] = {}
+    for value in vars(module).values():
+        name = _provider_spec_name(value) if issubclass(type(value), type) else None
+        if name is not None:
+            out[name] = value
+    return out
+
+
+def provider_packages(source_root: Path | None) -> list[tuple[str, str]]:
+    """``(package, distribution)`` of every installed module and every
+    top-level package of the source tree."""
+    found = [(m.path, m.distribution) for m in installed_modules()]
+    if source_root is not None and source_root.is_dir():
+        for child in sorted(source_root.iterdir()):
+            if (child / "__init__.py").is_file() and all(
+                p != child.name for p, _ in found
+            ):
+                found.append((child.name, "?"))
+    return found
+
+
+def _declared_consumes(directory: Path) -> list[str]:
+    path = directory / "module.snapshot.json"
+    try:
+        doc = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return []
+    return [str(u["name"]) for u in doc.get("consumes", []) if "name" in u]
+
+
+def module_files(  # noqa: C901, PLR0912
+    package: str,
+    directory: Path,
+    source_root: Path | None,
+    shared_packages: tuple[str, ...],
+    format_dto: Callable[[str, Path], str],
+) -> list[Planned]:
+    """The consumer artifacts of the module distribution ``package``, planned
+    WITHOUT composing anything (its own imports, the importable providers'
+    ``contracts`` modules, its committed copies)."""
+    out_dir = directory / GENERATED / "contracts"
+    stems = imported_stems(package, directory)
+    if not stems:
+        return []
+    # Every contract an importable provider declares, by owning package.
+    providers: dict[str, Provider] = {}
+    for pkg, dist in provider_packages(source_root):
+        if pkg == package:
+            continue
+        for name, impl in provider_contracts(pkg).items():
+            if name in providers and providers[name].package != pkg:
+                # Two importable packages declare one contract name (B-F4).
+                providers[name].distribution += f" | {dist} ({pkg})"
+                continue
+            providers[name] = Provider(name, impl, pkg, dist, composed=False)
+    declared = _declared_consumes(directory)
+    names = sorted({*providers, *declared, *_committed_names(out_dir)})
+    by_stem: dict[str, list[str]] = {}
+    for name in names:
+        by_stem.setdefault(stem_of(name), []).append(name)
+    out: list[Planned] = []
+    wanted: set[str] = set()
+
+    def refuse(stem: str, problem: str) -> None:
+        out.append(Planned(out_dir / f"{stem}.py", "", CODE_ABSENT, [problem]))
+
+    for stem in sorted(stems):
+        if stem.endswith("_dto"):
+            short = stem[: -len("_dto")]
+            pulled = {
+                n
+                for n in declared
+                if (
+                    module_name(providers[n].package) == short
+                    if n in providers
+                    else n.split(".")[0] == short
+                )
+            }
+            if not pulled:
+                pulled = {
+                    n for n, p in providers.items() if module_name(p.package) == short
+                }
+            if not pulled:
+                refuse(
+                    stem,
+                    f"{package} imports {stem}: no declared consumed contract and "
+                    f"no importable provider module named {short!r}",
+                )
+            wanted |= pulled
+            continue
+        matches = by_stem.get(stem, [])
+        if len(matches) > 1:
+            refuse(
+                stem,
+                f"stub name collision: contracts {' and '.join(matches)} both map "
+                f"to {stem}.py; rename one contract",
+            )
+        elif not matches:
+            refuse(
+                stem,
+                f"refused: {package} imports {stem}, which no importable provider, "
+                "declared consumed contract or committed copy maps to (provider "
+                "not installed here?)",
+            )
+        else:
+            wanted.add(matches[0])
+    for name in sorted(wanted):
+        group = by_stem[stem_of(name)]
+        if len(group) > 1:
+            refuse(
+                stem_of(name),
+                f"stub name collision: contracts {' and '.join(group)} both map "
+                f"to {stem_of(name)}.py; rename one contract",
+            )
+    wanted = {w for w in wanted if len(by_stem[stem_of(w)]) == 1}
+    grouped: dict[str, list[Provider]] = {}
+    for name in sorted(wanted):
+        provider = providers.get(name)
+        if provider is None:
+            out += _keep_committed(package, name, out_dir)
+            continue
+        if " | " in provider.distribution:
+            refuse(
+                stem_of(name),
+                f"two importable packages declare {name}: {provider.distribution} "
+                f"({provider.package})",
+            )
+            continue
+        grouped.setdefault(module_name(provider.package), []).append(provider)
+    for short, group in sorted(grouped.items()):
+        out += _render_group(
+            package, short, group, out_dir, shared_packages, format_dto
+        )
+    return out
+
+
+def stem_of(contract: str) -> str:
+    return "_".join(contract.split("."))
+
+
+def _committed_names(out_dir: Path) -> list[str]:
+    names = []
+    for path in sorted(out_dir.glob(f"*{EXPECTATION_SUFFIX}")):
+        try:
+            names.append(str(json.loads(path.read_text(encoding="utf-8"))["contract"]))
+        except (OSError, ValueError, KeyError):
+            continue
+    return names
+
+
+def _keep_committed(package: str, contract: str, out_dir: Path) -> list[Planned]:
+    """No provider: keep and verify the committed copy, else refuse."""
+    stem = stem_of(contract)
+    stub = out_dir / f"{stem}.py"
+    expectation = out_dir / f"{stem}{EXPECTATION_SUFFIX}"
+    owner = contract.split(".")[0]
+    if not stub.is_file() or not expectation.is_file():
+        return [
+            Planned(
+                stub,
+                "",
+                CODE_ABSENT,
+                [
+                    f"refused: {package} consumes {contract}; its provider (module "
+                    f"{owner!r}) is not importable here and no copy is committed. "
+                    f"Install the provider as a development dependency, or commit "
+                    f"the copy generated where it is installed"
+                ],
+            )
+        ]
+    out: list[Planned] = []
+    for path in (stub, *_dto_files_of(stub)):
+        text = path.read_text(encoding="utf-8")
+        item = Planned(path, text, CODE_ABSENT)
+        problem = verify(text)
+        if problem:
+            item.problems.append(f"committed copy of {contract}: {problem}")
+        out.append(item)
+    doc = json.loads(expectation.read_text(encoding="utf-8"))
+    meta, _ = strip_header(stub.read_text(encoding="utf-8"))
+    exp = Planned(expectation, expectation.read_text(encoding="utf-8"), CODE_ABSENT)
+    if meta.get("fingerprint") != doc.get("fingerprint"):
+        exp.problems.append(
+            f"committed copy of {contract}: stub fingerprint "
+            f"{meta.get('fingerprint')} != expectation {doc.get('fingerprint')}"
+        )
+    out.append(exp)
+    return out
+
+
+def _dto_files_of(stub: Path) -> list[Path]:
+    text = stub.read_text(encoding="utf-8")
+    found = []
+    for line in text.splitlines():
+        if line.startswith("from ") and "._generated.contracts." in line:
+            stem = line.split()[1].rsplit(".", 1)[-1]
+            path = stub.parent / f"{stem}.py"
+            if path.is_file() and path not in found:
+                found.append(path)
+    return found
+
+
+def _render_group(  # noqa: PLR0913
+    package: str,
+    short: str,
+    group: list[Provider],
+    out_dir: Path,
+    shared_packages: tuple[str, ...],
+    format_dto: Callable[[str, Path], str],
+) -> list[Planned]:
+    import sandloom.core.cli.generated as _generated  # noqa: PLC0415 (cycle)
+
+    stem_dto = _dto_copies.dto_module_stem(short)
+    resolver = _dto_copies.Resolver(
+        provider_package=group[0].package,
+        dto_package=f"{package}.{GENERATED}.contracts.{stem_dto}",
+        shared_packages=shared_packages,
+    )
+    out: list[Planned] = []
+    refused: list[str] = []
+    for provider in group:
+        try:
+            _generated.render_stub(provider.contract, provider.impl, resolver)
+        except _dto_copies.CopyError as exc:
+            refused.append(f"{provider.contract}: {exc}")
+    for provider in group:
+        stem = stem_of(provider.contract)
+        doc = expectation_document(provider)
+        path = out_dir / f"{stem}.py"
+        body = (
+            _generated.render_stub(provider.contract, provider.impl, resolver)
+            if not refused
+            else ""
+        )
+        content = with_header(
+            _strip_old_header(body),
+            [
+                f"contract: {provider.contract}  fingerprint: {doc['fingerprint']}",
+                f"provider: {provider.distribution} ({doc['provider']['class']})",
+            ],
+        )
+        item = Planned(path, content, "SANDLOOM-T007", list(refused))
+        current = path.read_text(encoding="utf-8") if path.is_file() else None
+        item.problems += _generated.stub_problems(current, content)
+        out.append(item)
+        out.append(
+            Planned(
+                out_dir / f"{stem}{EXPECTATION_SUFFIX}",
+                _contract_compat.render_snapshot(doc),
+                "SANDLOOM-T004",
+            )
+        )
+    if resolver.copied:
+        dto_path = out_dir / f"{stem_dto}.py"
+        try:
+            text = format_dto(_dto_copies.render_module(short, resolver), dto_path)
+        except _dto_copies.CopyError as exc:
+            refused.append(str(exc))
+            text = ""
+        fps = ", ".join(f"{p.contract} {contract_schema(p.impl).hash}" for p in group)
+        out.append(
+            Planned(
+                dto_path,
+                with_header(_strip_old_header(text), [f"contracts: {fps}"]),
+                _dto_copies.CODE,
+                refused,
+            )
+        )
+    return out
+
+
+def _strip_old_header(text: str) -> str:
+    """The body without the legacy one-line HEADER (the provenance header
+    replaces it)."""
+    return (
+        text[len(_dto_copies.HEADER) :] if text.startswith(_dto_copies.HEADER) else text
+    )
+
+
+def stub_collisions(contracts: Iterable[str]) -> dict[str, list[str]]:
+    """``{stem: [contract, ...]}`` of stems two contracts share."""
+    by_stem: dict[str, list[str]] = {}
+    for name in sorted(set(contracts)):
+        by_stem.setdefault(stem_of(name), []).append(name)
+    return {s: n for s, n in by_stem.items() if len(n) > 1}
+
+
