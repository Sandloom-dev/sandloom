# @@TITLE@@ — microservices profile (created by `sandloom add deploy`).
# The SAME image runs once per service; each instance loads its modules via
# SANDLOOM_MODULES and owns its OWN Postgres database (one server, one database per
# service, created by postgres/init-databases.sh). Modules keep communicating
# exactly as in the monolith:
#   * events  — the durable Redis Streams bus (EVENT_BUS_BACKEND=streams) on the
#     shared CACHE_URL; each service's outbox lives in its own database;
#   * sync contracts — a co-deployed provider is called in-process, otherwise
#     SERVICE_BINDINGS supplies a generated internal RPC proxy to the owning
#     service. Each call is authenticated with an HMAC under a key only the
#     caller and the provider can derive from their own X25519 keys (pair-MAC,
#     ADR-0004): audience-bound, replay-guarded; the provider allows only what
#     RPC_ALLOWED_CALLS lists for the caller (= that caller's SERVICE_BINDINGS).
#
# No application code changes between the profiles — configuration only.
#
# Generated blocks. `sandloom add deploy <module>... --service <name>` (re)writes
# everything between a `# >>> generated by sandloom add deploy` marker and its
# `# <<<` end: the services, their bindings, RPC_ALLOWED_CALLS, the databases
# and the gateway routes, all derived from what each service's modules provide
# and consume. Edit anything OUTSIDE the markers freely (it is kept); an edit
# INSIDE one makes the next run refuse with a diff (`--force` overwrites it).
# `sandloom add deploy --refresh` re-derives every block after a code change (a new
# consumed contract, a new route prefix); `sandloom test` (schema & deploy) checks
# the profile and says when it is stale.
#
# Keys. Access tokens are ASYMMETRIC (EdDSA): the token issuer (the service
# loading identity) alone holds JWT_PRIVATE_KEY (+ JWT_SECRET for its emailed
# tokens); every other service verifies with JWT_PUBLIC_KEYS and cannot mint.
# Every service holds its own X25519 key (RPC_DH_PRIVATE_KEY); a calling
# service also an Ed25519 key (RPC_PRIVATE_KEY) that signs its commands.
#
#   development / CI only (fresh random keys in a plain file, never production):
#     sandloom keys dev-env --out deploy/.env.microservices
#     docker compose --env-file deploy/.env.microservices \
#       -f deploy/compose/microservices.yml up --build
#   production: `sandloom keys generate` (the JWT pair), `sandloom keys generate --purpose
#     rpc --service <caller>` / `--purpose rpc-dh --service <provider>` per
#     service, into your secret store (each variable the profile requires
#     names the command that makes it).
#
# Two stacks on one host: set COMPOSE_PROJECT_NAME (or -p), GATEWAY_PORT and a
# free SANDLOOM_SUBNET with a matching SANDLOOM_GATEWAY_IP / SANDLOOM_IP_RANGE (the gateway's
# fixed address is the only trusted proxy hop; it must lie in SANDLOOM_SUBNET but
# OUTSIDE SANDLOOM_IP_RANGE, the pool Docker hands the other containers' dynamic
# addresses from).
#
# Probes: liveness = /health/simple (a peer outage never fails it); readiness
# = /ready, which a peer fails only for bindings marked "required": true.

x-build: &build
  context: @@BUILD_CONTEXT@@
  dockerfile: @@DOCKERFILE@@
  target: production

# ONE image for every process: built once, tagged, reused by all services.
x-image: &image ${SANDLOOM_IMAGE:-@@IMAGE@@}

x-service-runtime: &service-runtime
  stop_grace_period: 60s
  logging:
    driver: json-file
    options:
      max-size: "10m"
      max-file: "3"

# Settings shared by EVERY process (services, migrations, workers, beat).
# Anything security/auth-relevant lives HERE, never in a per-service block:
# a token minted by the issuer is verified by every service, so the JWT
# settings must be identical everywhere (`sandloom test` checks it).
x-common-env: &common-env
  ENVIRONMENT: prod
@@APP_ENV@@  SHUTDOWN_BUDGET_SECONDS: ${SHUTDOWN_BUDGET_SECONDS:-30}
  EVENT_PAYLOAD_MAX_BYTES: ${EVENT_PAYLOAD_MAX_BYTES:-262144}
  EVENT_STREAM_RETENTION_SECONDS: ${EVENT_STREAM_RETENTION_SECONDS:-604800}
  EVENT_STREAM_MAXLEN: ${EVENT_STREAM_MAXLEN:-0}
  EVENT_STREAM_PREFIX: ${EVENT_STREAM_PREFIX:-}
  # The weaker guarantees this stack accepts (logged at every start): demo
  # single-host local storage, shared by every process (not multi-host HA). A
  # demo without Stripe adds fake_psp_in_prod.
  SANDLOOM_ACCEPTED_RISKS: ${SANDLOOM_ACCEPTED_RISKS:-local_storage_in_prod}
  # Shared Redis: cache + the Streams event bus every service publishes to and
  # consumes from. Celery brokers are per service (BROKER_URL per service).
  # Invariant: CACHE_URL is the SAME for every service — access-token
  # revocation marks, rate-limit buckets, idempotency keys and the event bus
  # live there; a per-service cache would let a revoked token through on
  # every service but the one that revoked it.
  CACHE_URL: redis://redis:6379/0
  # Opt-in (off by default): idempotency records on their own Redis instead of
  # the security cache (deploy/README.md -> "Separate idempotency Redis").
  # Enable together with the idempotency-redis service below, identically in
  # EVERY process:
  # INFRA: '{"cache": {"idempotency": {"driver": "redis", "url": "redis://idempotency-redis:6379/0"}}}'
  # IDEMPOTENCY_CACHE_INSTANCE: idempotency
  EVENT_BUS_BACKEND: streams
  # Asymmetric access tokens (a shared HS secret would let every service mint
  # tokens). Public keys by kid — every key still accepted during a rotation;
  # JWT_KID names the one the issuer signs with.
  JWT_ALGORITHM: EdDSA
  JWT_PUBLIC_KEYS: ${JWT_PUBLIC_KEYS:?set JWT_PUBLIC_KEYS (sandloom keys generate)}
  JWT_KID: ${JWT_KID:?set JWT_KID (the kid of JWT_PRIVATE_KEY in JWT_PUBLIC_KEYS)}
  JWT_ISSUER: ${JWT_ISSUER:-}
  JWT_AUDIENCE: ${JWT_AUDIENCE:-}
  ACCESS_TOKEN_EXPIRE_MINUTES: ${ACCESS_TOKEN_EXPIRE_MINUTES:-15}
  REFRESH_TOKEN_EXPIRE_DAYS: ${REFRESH_TOKEN_EXPIRE_DAYS:-14}
  # Unlocks /diagnostics, /contracts, /metrics and /health details. It does
  # NOT authenticate internal RPC: /_sandloom/rpc only accepts calls authenticated
  # with a per-pair key.
  INTERNAL_API_TOKEN: ${INTERNAL_API_TOKEN:?set INTERNAL_API_TOKEN (openssl rand -hex 32)}
  # Internal RPC (ADR-0004). Ed25519 public keys of every calling service
  # ({"<service>": {"<kid>": "<PEM>"}}): every COMMAND call is signed with the
  # caller's key, so a leaked provider X25519 key can forge reads at most.
  RPC_SERVICE_KEYS: ${RPC_SERVICE_KEYS:?set RPC_SERVICE_KEYS (sandloom keys generate --purpose rpc)}
  # The X25519 public keys of every service ({"<service>": {"<kid>": "<PEM>"}};
  # callers address a service's LAST kid).
  RPC_SERVICE_DH_KEYS: ${RPC_SERVICE_DH_KEYS:?set RPC_SERVICE_DH_KEYS (sandloom keys generate --purpose rpc-dh)}
  # Deny by default: each caller may call exactly the contracts its
  # SERVICE_BINDINGS bind.
  # >>> generated by sandloom add deploy: allowlist
  # <<< generated by sandloom add deploy: allowlist
  METRICS_TOKEN: ${METRICS_TOKEN:-}
  FRONTEND_URL: ${FRONTEND_URL:-http://localhost:3000}
  # Subscription gates evaluate the same past-due policy on every service.
  BILLING_DENY_ON_PAST_DUE: ${BILLING_DENY_ON_PAST_DUE:-false}
  NOTIFIER_BACKEND: ${NOTIFIER_BACKEND:-log}
  SMTP_HOST: ${SMTP_HOST:-}
  SMTP_PORT: ${SMTP_PORT:-25}
  SMTP_USERNAME: ${SMTP_USERNAME:-}
  SMTP_PASSWORD: ${SMTP_PASSWORD:-}
  SMTP_FROM: ${SMTP_FROM:-}
  SMTP_USE_TLS: ${SMTP_USE_TLS:-true}
  # Dedicated contract pool (in-process contract calls / claims contributors)
  # per process, on top of DB_POOL_SIZE + DB_MAX_OVERFLOW. Kept small: the
  # connection budget of the whole stack must fit max_connections (db below).
  CONTRACT_DB_POOL_SIZE: ${CONTRACT_DB_POOL_SIZE:-1}
  CONTRACT_DB_MAX_OVERFLOW: ${CONTRACT_DB_MAX_OVERFLOW:-2}
  # Every module a service lists in SANDLOOM_MODULES is REQUIRED: a module that
  # fails to import aborts the process instead of serving an empty,
  # healthy-looking service.

# Per-service configuration: its modules, database, broker, RPC identity and
# exactly the contracts it consumes from other services.
# >>> generated by sandloom add deploy: service-env
# <<< generated by sandloom add deploy: service-env

# HTTP service template (environment supplied per service).
x-http-service: &http-service
  <<: *service-runtime
  image: *image
  build: *build
  volumes:
    - appdata:/app/data
  restart: unless-stopped
  healthcheck:
    test: ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:@@PORT@@/health/simple')\""]
    interval: 15s
    timeout: 5s
    retries: 5
  deploy:
    resources:
      limits:
        cpus: "1.0"
        memory: 512m

# HTTP-only tuning shared by every service.
x-http-env: &http-env
  # Every request arrives via the nginx gateway (fixed address below), which
  # appends the client to X-Forwarded-For. Trust ONLY that hop.
  TRUST_PROXY_HEADERS: "true"
  TRUSTED_PROXY_IPS: '["${SANDLOOM_GATEWAY_IP:-172.28.0.10}/32"]'
  # Sizing: services x WEB_CONCURRENCY x (DB_POOL_SIZE + DB_MAX_OVERFLOW +
  # CONTRACT_DB_POOL_SIZE + CONTRACT_DB_MAX_OVERFLOW) + workers + beats +
  # migrate one-shots must fit the db's max_connections (generated below).
  WEB_CONCURRENCY: ${WEB_CONCURRENCY:-2}
  # Idle keep-alive (s) of the gunicorn/uvicorn workers; above the gateway's
  # / any LB's idle timeout (ALB 60 s) so the app never closes first.
  GUNICORN_KEEPALIVE: ${GUNICORN_KEEPALIVE:-75}
  GUNICORN_GRACEFUL_TIMEOUT: ${GUNICORN_GRACEFUL_TIMEOUT:-45}
  DB_POOL_SIZE: ${DB_POOL_SIZE:-5}
  DB_MAX_OVERFLOW: ${DB_MAX_OVERFLOW:-5}
  # One relay per container (the gunicorn leader worker) drains THIS service's
  # outbox (its own database).
  OUTBOX_RELAY_ENABLED: auto

# Celery worker sizing (sandloom.core.worker): the child count comes from the
# container CPU quota (capped); every child opens its own small DB pool.
x-worker-env: &worker-env
  # Recycle a child that grew past this resident size (KiB) after its task.
  WORKER_MAX_MEMORY_PER_CHILD: ${WORKER_MAX_MEMORY_PER_CHILD:-200000}
  DB_POOL_SIZE: ${WORKER_DB_POOL_SIZE:-2}
  DB_MAX_OVERFLOW: ${WORKER_DB_MAX_OVERFLOW:-2}

# One-shot migration template: core chain (outbox/audit/inbox) + the service's
# module chains, into the service's own database, created first when missing
# (init-databases.sh runs only on an empty volume; a service added later).
x-migrate: &migrate
  image: *image
  build: *build
  command: ["sandloom", "migrate", "upgrade-all", "--apply", "--create-databases"]
  depends_on:
    db:
      condition: service_healthy
  restart: "no"

x-after-migrate: &after-migrate
  db:
    condition: service_healthy
  redis:
    condition: service_started

services:
  # Per service: a migrate one-shot against its own database, the HTTP
  # service (after it), and a worker (+ the ONE beat of its broker) when its
  # modules ship tasks (periodic ones).
  # >>> generated by sandloom add deploy: services
  # <<< generated by sandloom add deploy: services

  # ---- edge -------------------------------------------------------------------
  gateway:
    <<: *service-runtime
    # >= 1.27.3: `server ... resolve` re-resolves recreated containers.
    image: nginx:1.28-alpine
    ports:
      - "${GATEWAY_PORT:-8080}:8080"
    volumes:
      - ../gateway/nginx.conf:/etc/nginx/nginx.conf:ro
    networks:
      default:
        # Fixed address = the only trusted proxy hop (TRUSTED_PROXY_IPS).
        ipv4_address: ${SANDLOOM_GATEWAY_IP:-172.28.0.10}
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:8080/health >/dev/null"]
      interval: 15s
      timeout: 3s
      retries: 3
    depends_on:
      # >>> generated by sandloom add deploy: gateway-depends
      # <<< generated by sandloom add deploy: gateway-depends
    restart: unless-stopped

  # ---- infrastructure ---------------------------------------------------------
  db:
    <<: *service-runtime
    image: postgres:16
    # max_connections fits the connection budget of every process above
    # (generated); one database per service, created on the volume's first
    # start.
    # >>> generated by sandloom add deploy: database
    # <<< generated by sandloom add deploy: database
    volumes:
      - pgdata:/var/lib/postgresql/data
      - ../postgres/init-databases.sh:/docker-entrypoint-initdb.d/10-init-databases.sh:ro
    healthcheck:
      # TCP probe: the init phase runs a socket-only temporary server, so this
      # passes only once init-databases.sh finished and the real server is up.
      test: ["CMD-SHELL", "pg_isready -h 127.0.0.1 -U sandloom"]
      interval: 5s
      timeout: 3s
      retries: 20
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: "2.0"
          memory: 1g

  redis:
    <<: *service-runtime
    image: redis:7
    # Streams are the durable event log: persist them (AOF), and never evict
    # bus keys under memory pressure (writes fail loudly instead).
    command: ["redis-server", "--appendonly", "yes", "--maxmemory", "384mb", "--maxmemory-policy", "noeviction"]
    volumes:
      - redisdata:/data
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: 512m

  # Opt-in idempotency Redis (see the IDEMPOTENCY_CACHE_INSTANCE note in the
  # shared env above). Same persistence as a security Redis — fsync every
  # write, never evict: a lost reservation re-runs a mutation.
  # idempotency-redis:
  #   <<: *service-runtime
  #   image: redis:7
  #   command: ["redis-server", "--appendonly", "yes", "--appendfsync", "always", "--maxmemory", "256mb", "--maxmemory-policy", "noeviction"]
  #   volumes:
  #     - idempotencyredisdata:/data
  #   restart: unless-stopped
  #   deploy:
  #     resources:
  #       limits:
  #         cpus: "1.0"
  #         memory: 384m

volumes:
  appdata:
  pgdata:
  redisdata:
  # idempotencyredisdata:   # with the opt-in idempotency-redis service

networks:
  default:
    ipam:
      config:
        - subnet: ${SANDLOOM_SUBNET:-172.28.0.0/24}
          # Dynamic addresses come only from the upper half, so the static
          # gateway address (SANDLOOM_GATEWAY_IP, .10) can never be taken first.
          ip_range: ${SANDLOOM_IP_RANGE:-172.28.0.128/25}
