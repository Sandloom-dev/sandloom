# ==== Test Environment ====
ENVIRONMENT=test
SANDLOOM_ACCEPTED_RISKS=local_storage_in_prod

# ==== Database (Test) ====
DATABASE_URL=postgresql+asyncpg://test_user:test_password@127.0.0.1:5433/sandloom_test

# ==== Infrastructure (Redis) ====
# Every Redis instance states its own url: no instance takes it from a flat
# setting or from another instance. The driver comes from the composition
# (sandloom_standard selects redis and celery). The authoring commands of this
# checkout (sandloom generate; the generated-files and schema & deploy steps of
# sandloom test) build sandloom_standard.main with no setting: pyproject.toml
# names it under [tool.sandloom] composition-root, and an explicit
# SANDLOOM_COMPOSITION_ROOT still wins. The pytest suites take their root from
# conftest.py, never from that key. The cache and the security store share db 15: the testing fixtures
# (sandloom_cache, revocation_mark_key) write the revocation and block marks
# through the cache and the application reads them from the security store, as
# every app's own .env.test has it. The instances that must not lose a key
# (beat lease, broadcast) and the Celery broker share db 14, so a cache flush
# never clears them. A test burst opens
# many connections at once on a machine shared by parallel suites (DNS lookups
# queue in the default executor): the 0.5 s production connect budget flakes
# there, hence the 5 s on the cache. Outage tests use refused ports.
# SANDLOOM_TEST_CACHE_URL / SANDLOOM_TEST_BROKER_URL point the cache and the
# broker (and the instances on their database) at another Redis.
INFRA='{"cache":{"default":{"url":"redis://127.0.0.1:6380/15","socket_connect_timeout_seconds":5}},"atomic_store":{"security":{"url":"redis://127.0.0.1:6380/15"}},"lease":{"beat":{"url":"redis://127.0.0.1:6380/14"}},"broadcast":{"default":{"url":"redis://127.0.0.1:6380/14"}},"taskqueue":{"default":{"broker":"redis://127.0.0.1:6380/14"}}}'

# ==== Event bus ====
# The suite runs the in-process bus; the kernel and the standard composition name
# none by default (no automatic memory), a test or a dev app names it here.
EVENT_BUS_BACKEND=memory

# ==== Storage ====
STORAGE_TYPE=local
STORAGE_PATH=./test_data

# ==== JWT / Security ====
JWT_SECRET=test_super_secret_key_for_testing_only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# ==== Frontend ====
FRONTEND_URL=http://localhost:3000

# ==== SSO (Mock for tests) ====
GOOGLE_CLIENT_ID=ci-dummy-google-client-id
GOOGLE_CLIENT_SECRET=ci-dummy-google-client-secret
# best-effort session-owner detection (SANDLOOM-R013), on in tests
DB_SESSION_OWNER_CHECKS=true
