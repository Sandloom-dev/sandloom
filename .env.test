# ==== Test Environment ====
ENVIRONMENT=test
SANDLOOM_ACCEPTED_RISKS=local_storage_in_prod

# ==== Database (Test) ====
DATABASE_URL=postgresql+asyncpg://test_user:test_password@127.0.0.1:5433/sandloom_test

# ==== Cache (Redis) ====
CACHE_URL=redis://127.0.0.1:6380/15
# A test burst opens many connections at once on a machine shared by
# parallel suites (DNS lookups queue in the default executor): the 0.5 s
# production connect budget flakes there. Outage tests use refused ports.
CACHE_SOCKET_CONNECT_TIMEOUT_SECONDS=5

# ==== Broker (Celery / tasks) ====
BROKER_URL=redis://127.0.0.1:6380/14

# ==== Storage ====
STORAGE_TYPE=local
STORAGE_PATH=./test_data

# ==== JWT / Security ====
JWT_SECRET=test_super_secret_key_for_testing_only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# ==== Frontend ====
FRONTEND_URL=http://localhost:3000

# ==== SSO (Mock for tests) ====
GOOGLE_CLIENT_ID=ci-dummy-google-client-id
GOOGLE_CLIENT_SECRET=ci-dummy-google-client-secret
# best-effort session-owner detection (SANDLOOM-R013), on in tests
DB_SESSION_OWNER_CHECKS=true
