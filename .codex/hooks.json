{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit|MultiEdit|Bash|mcp__tm([-_][A-Za-z0-9-]+(?:_[A-Za-z0-9-]+)*)?__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "tm hook codex"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "tm hook codex"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "tm hook codex"
          }
        ]
      }
    ]
  }
}
