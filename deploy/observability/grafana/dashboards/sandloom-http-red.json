          "expr": "sum(rate(sandloom_http_requests_total{job=~\"$job\", path=~\"$route\", path!~\"/health.*|/ready|/metrics|<unmatched>\"}[$__rate_interval]))",
          "legendFormat": "",
          "refId": "A"
