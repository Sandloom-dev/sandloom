  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "sandloom"
      ],
      "title": "Sandloom dashboards",
      "type": "dashboards"
    }
  ],
