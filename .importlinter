    sandloom.core.rpc_binding
    sandloom.core.rpc_identity
    sandloom.core.rpc_pair_mac
    sandloom.core.rpc_transport
    sandloom.core.rpc_transport_compat
    sandloom.core.runtime
    sandloom.core.sagas
    sandloom.core.schema
    sandloom.core.signing_keys
    sandloom.core.sql_alchemy
    sandloom.core.tasks
    sandloom.core.tenant
    sandloom.core.tenant_context
    sandloom.core.testing
    sandloom.core.unit_of_work
    sandloom.core.utils
    sandloom.core.worker

; ----------------------------------------------- eventing speaks no transport
; ADR-0016 (design/infra-drivers/design.md, slice idk-ratchets): the delivery
; logic of sandloom.core.eventing sits above a transport and imports no
; transport implementation, no driver and no backend SDK. The volatile bus
; (pubsub_bus) runs over the broadcast capability and is a delivery module. The
; Redis Streams transport lives in the sandloom-redis package
; (sandloom_redis.eventbus, idk-pkg-redis-eventbus), so the whole package is the source: a new eventing module is held to the
; rule without being listed. No ignore_imports (G-KERNEL-04).

[importlinter:contract:eventing-no-transport-impl]
name = sandloom.core.eventing imports no transport implementation, driver or backend SDK (ADR-0016)
type = forbidden
source_modules =
    sandloom.core.eventing
forbidden_modules =
    sandloom.core.drivers
    redis
    aioredis
    celery
    kombu
    boto3
    botocore
    aiobotocore
    asyncpg
    psycopg
    psycopg2

; The driver kit imports no driver (idk-streams-driverkitb): a driver depends on
; the kit, never the reverse. In a package split the kit stays in the kernel
; wheel, which cannot import a driver package. The source is the whole kit, so a
; new kit module is held to it. No ignore_imports (G-KERNEL-04).
[importlinter:contract:driverkit-no-driver]
name = sandloom.driverkit imports no built-in driver (ADR-0016)
type = forbidden
source_modules =
    sandloom.driverkit
forbidden_modules =
    sandloom.core.drivers

; ---------------------------------------------------------------- sandloom.sdk
; Public API 1.0 (spec §3, ADR-0010; text supplied by WS-B at H0). sandloom.sdk
; sits above the kernel: it may import only the public kernel surface (the
; modules Appendix C maps to it), never a kernel internal (indirect imports
; through that surface are the surface's business); the kernel never imports
; it; and inside it the public modules > _decl (L1) > _prim (L2).

[importlinter:contract:sdk-kernel-surface]
name = sandloom.sdk imports only the public kernel surface (spec §3)
type = forbidden
source_modules =
    sandloom.sdk
forbidden_modules =
    sandloom.core._internal
    sandloom.core.admin
    sandloom.core.archcheck
    sandloom.core.async_runner
    sandloom.core.auth
    sandloom.core.claims
    sandloom.core.composition
