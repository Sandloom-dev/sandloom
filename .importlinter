; The kernel names no task-queue backend (idk-worker-port): Celery's worker,
; scheduler, signals and bootsteps live in sandloom_celery.worker (the
; sandloom-celery package) behind TaskQueueProvider.worker_host(), and the kernel runs a task through the
; WorkerBoot it hands the host. Same sources as the contract above (every
; sandloom.core child but drivers); a new core child is added to both, and
; tests/architecture/test_kernel_backend_imports.py ratchets the other backends.
; No ignore_imports, no allow_indirect_imports.
[importlinter:contract:kernel-never-imports-celery]
name = the kernel (sandloom.core but its built-in drivers, sandloom.shared) never imports celery or kombu (ADR-0016)
type = forbidden
source_modules =
    sandloom.shared
    sandloom.core._internal
    sandloom.core.admin
    sandloom.core.app_factory
    sandloom.core.archcheck
    sandloom.core.async_runner
