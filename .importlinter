    sandloom.core.module_api._spec
    sandloom.core.testing._uow
allow_indirect_imports = true

[importlinter:contract:kernel-never-imports-sdk]
name = the kernel (sandloom.core, sandloom.shared) never imports sandloom.sdk (ADR-0010)
type = forbidden
source_modules =
    sandloom.core
    sandloom.shared
forbidden_modules =
    sandloom.sdk

; The kernel never imports the driver door either, with one exception that is
; ADR-0016's rule rather than a break of it: a built-in driver (sandloom.core.
; drivers) imports only sandloom.driverkit, as a driver package does, so that
; its file moves whole to a package (spec section 1). The sources are every
; sandloom.core child but drivers (import-linter takes no exclusion of a
; sub-package, and ignore_imports is refused, G-KERNEL-04): a new core child is
; added here, as to the layers above, and tests/architecture keeps the layers
; exhaustive.
[importlinter:contract:kernel-never-imports-driverkit]
name = the kernel (sandloom.core but its built-in drivers, sandloom.shared) never imports sandloom.driverkit (ADR-0010, ADR-0016)
type = forbidden
source_modules =
    sandloom.shared
    sandloom.core._internal
    sandloom.core.admin
    sandloom.core.app_factory
    sandloom.core.archcheck
    sandloom.core.async_runner
