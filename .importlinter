[importlinter:contract:sdk-decl-l1]
name = L1 (sandloom.sdk._decl) is built only from L2: no kernel import (spec §3)
type = forbidden
source_modules =
    sandloom.sdk._decl
forbidden_modules =
    sandloom.core
    sandloom.shared.authz
    sandloom.shared.guards
allow_indirect_imports = true

[importlinter:contract:sdk-layers]
name = sandloom.sdk is layered: public modules > _decl > _prim (spec §3)
type = layers
containers =
    sandloom.sdk
layers =
    module : app : migrations : tooling : web : data : tenant : events : effects : contracts : authz : sagas : projections : infra : security : errors : testing
    _decl
    _prim

; ------------------------------------------------------- business modules
; Invariant I-02 (design/kernel-boundary/requirements.md): shipped kernel code
; imports no business-module implementation. forbidden_modules lists every
; sandloom_* package of src/ and of the sandloom.modules entry points;
; tests/architecture/test_kernel_import_contracts.py fails when one is
; missing. Dynamic imports are not in the graph: test_shared_purity.py and
; tools/packaging/distribution_imports.py read those.

[importlinter:contract:kernel-imports-no-module]
name = the kernel (sandloom.core, sandloom.sdk, sandloom.shared, sandloom.main) imports no business-module package (I-02)
type = forbidden
source_modules =
    sandloom.core
    sandloom.sdk
    sandloom.shared
    sandloom.main
forbidden_modules =
    sandloom_admin
    sandloom_billing
    sandloom_identity
    sandloom_tenancy
