{
  "tm": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "tm hook agy pre-tool-use"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(run_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "tm hook agy post-tool-use"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "tm hook agy session-start"
      }
    ]
  }
}
