# ==== Modules loaded by this process ====
# Default: every module of oidc_identity/modules (and the bundled ones). Set to select
# a subset: SANDLOOM_MODULES=["oidc_identity.modules.<name>", ...]
# SANDLOOM_MODULES=
# Generated contract stubs and DTO copies live here (importable by every process).
CONTRACT_DTO_PACKAGES=["oidc_identity.shared"]
# Composition root booted by sandloom migrate, the worker and the `sandloom` ops CLIs.
SANDLOOM_COMPOSITION_ROOT=oidc_identity.asgi

# ==== Environment ====
ENVIRONMENT=dev

# ==== Database, cache, broker ====
# `uv run sandloom dev up` writes DATABASE_URL, CACHE_URL and BROKER_URL of this
# checkout's dev services into the block below; everything else is yours.
# >>> sandloom dev (managed by `sandloom dev up`; edits inside are replaced)
# Empty until `uv run sandloom dev up` fills it with this checkout's
# DATABASE_URL, CACHE_URL and BROKER_URL.
# <<< sandloom dev

# ==== Storage ====
STORAGE_TYPE=local
STORAGE_PATH=./data

# ==== Security ====
# Production startup rejects short / placeholder secrets. Generate one with
#   openssl rand -hex 32
JWT_SECRET=change_me_in_production_use_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# ==== Ops (unlocks /metrics, /diagnostics, /health details; never /_sandloom/rpc) ====
# Internal endpoints are CLOSED unless a token is set (>= 32 chars in prod).
# INTERNAL_API_TOKEN=
# Local development only: open them without a token (ignored in prod).
# INTERNAL_ENDPOINTS_OPEN_IN_DEV=true

# ==== The external OpenID provider (acme_idp) ====
# Its issuer URL (the discovery document's "issuer") and this application's
# client id (the "aud" an id_token must carry).
ACME_IDP_ISSUER=https://idp.example.com
ACME_IDP_CLIENT_ID=storefront-web
# ACME_IDP_ADMIN_GROUP=platform-admins
