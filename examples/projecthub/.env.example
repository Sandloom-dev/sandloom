# ==== Modules loaded by this process ====
SANDLOOM_MODULES=["projecthub.modules.projects", "projecthub.modules.tasks", "projecthub.modules.taskboard", "projecthub.modules.notifications"]
SANDLOOM_COMPOSITION_ROOT=projecthub.asgi
CONTRACT_DTO_PACKAGES=["projecthub.shared"]

# ==== Environment ====
ENVIRONMENT=dev

# ==== Database (default instance) ====
DATABASE_URL=postgresql+asyncpg://sandloom:sandloom@localhost:5432/projecthub

# ==== Cache / Broker (Redis) ====
INFRA='{"cache":{"default":{"url":"redis://localhost:6379/1"}},"broadcast":{"default":{"url":"redis://localhost:6379/3"}},"atomic_store":{"security":{"url":"redis://localhost:6379/4"}},"lease":{"beat":{"url":"redis://localhost:6379/5"}},"taskqueue":{"default":{"broker":"redis://localhost:6379/2"}}}'

# ==== Storage ====
# The in-process event bus, named explicitly (DEFAULT_INFRA selects Streams).
EVENT_BUS_BACKEND=memory

STORAGE_PATH=./data

# ==== Security ====
# Production startup rejects short / placeholder secrets. Generate one with
#   openssl rand -hex 32
JWT_SECRET=change_me_in_production_use_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# ==== Ops (unlocks /metrics, /diagnostics, /health details; never /_sandloom/rpc) ====
# Internal endpoints are CLOSED unless a token is set (>= 32 chars in prod).
# INTERNAL_API_TOKEN=
# Local development only: open them without a token (ignored in prod).
# INTERNAL_ENDPOINTS_OPEN_IN_DEV=true
