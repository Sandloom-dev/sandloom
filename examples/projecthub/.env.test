# ==== Test environment (loaded by the sandloom.sdk.testing pytest plugin) ====
ENVIRONMENT=test
SANDLOOM_MODULES=["projecthub.modules.projects", "projecthub.modules.tasks", "projecthub.modules.taskboard", "projecthub.modules.notifications"]
SANDLOOM_COMPOSITION_ROOT=projecthub.asgi
CONTRACT_DTO_PACKAGES=["projecthub.shared"]

# Point these at your test infrastructure. Defaults match the framework's
# docker-compose.test.yml (Postgres :5433, Redis :6380).
DATABASE_URL=postgresql+asyncpg://test_user:test_password@localhost:5433/sandloom_test
INFRA='{"cache":{"default":{"url":"redis://localhost:6380/15"}},"broadcast":{"default":{"url":"redis://localhost:6380/13"}},"atomic_store":{"security":{"url":"redis://localhost:6380/12"}},"lease":{"beat":{"url":"redis://localhost:6380/11"}},"taskqueue":{"default":{"broker":"redis://localhost:6380/14"}}}'

# The in-process event bus, named explicitly (DEFAULT_INFRA selects Streams).
EVENT_BUS_BACKEND=memory

STORAGE_TYPE=local
STORAGE_PATH=./test_data

JWT_SECRET=test_super_secret_key_for_testing_only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
