# ==== Test environment (loaded by the sandloom.sdk.testing pytest plugin) ====
ENVIRONMENT=test
SANDLOOM_MODULES=["academy.modules.payments", "academy.modules.notifications", "academy.modules.enrollment"]
SANDLOOM_COMPOSITION_ROOT=academy.asgi
CONTRACT_DTO_PACKAGES=["academy.shared"]

# Point these at your test infrastructure. Defaults match the framework's
# docker-compose.test.yml (Postgres :5433, Redis :6380).
DATABASE_URL=postgresql+asyncpg://test_user:test_password@localhost:5433/sandloom_test
# Cache, broadcast, security store and beat lease share the cache database here: the test harness
# points them at the run's own Redis together (an instance on another database keeps its url).
INFRA='{"cache":{"default":{"url":"redis://localhost:6380/15"}},"broadcast":{"default":{"url":"redis://localhost:6380/15"}},"atomic_store":{"security":{"url":"redis://localhost:6380/15"}},"lease":{"beat":{"url":"redis://localhost:6380/15"}},"taskqueue":{"default":{"broker":"redis://localhost:6380/14"}}}'

# The in-process event bus, named explicitly (DEFAULT_INFRA selects Streams).
EVENT_BUS_BACKEND=memory

STORAGE_TYPE=local
STORAGE_PATH=./test_data

JWT_SECRET=test_super_secret_key_for_testing_only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
