{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit|Bash|mcp__tm(-[A-Za-z0-9-]+)?__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "tm hook claude-code"
          }
        ]
      },
      {
        "matcher": "^(Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/agent_model_guard.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "tm hook claude-code"
          }
        ]
      },
      {
        "matcher": "^(Edit|Write|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff_format.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "tm hook claude-code"
          }
        ]
      }
    ]
  }
}
