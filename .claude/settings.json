{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit|Bash|mcp__tm(-[A-Za-z0-9-]+)?__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "tm hook claude-code"
          }
        ]
      },
      {
        "matcher": "^(Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/agent_model_guard.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\""
          }
        ]
      },
      {
        "matcher": "^mcp__tm(-[A-Za-z0-9-]+)?__task_done$",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/task_done_checks.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\"",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "tm hook claude-code"
          }
        ]
      },
      {
        "matcher": "^(Edit|Write|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/edit_check.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\"",
            "timeout": 45
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "tm hook claude-code"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "tm hook claude-code"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
