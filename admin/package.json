{
  "name": "@sandloom/admin",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/licenses.mjs && node scripts/check-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && node scripts/check-tokens.mjs",
    "test": "node --test scripts/dependency-compat.test.mjs && vitest run",
    "test:browser": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "contracts": "python3 scripts/export_openapi.py && openapi-typescript contracts/openapi.json -o src/api/generated.ts",
    "contracts:check": "python3 scripts/export_openapi.py --check && node scripts/check-types.mjs",
    "audit": "npm audit --audit-level=moderate",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:live": "../.venv/bin/python ../tools/smoke/admin_live_acceptance.py",
    "postinstall": "node scripts/apply-build-tool-patches.mjs && node --test scripts/dependency-compat.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.61.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-themes": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.6.3",
    "globals": "17.13.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "storybook": "10.6.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "glob": "14.0.2",
    "minimatch": "11.0.1",
    "uri-js": "npm:fast-uri@4.2.3"
  }
}
